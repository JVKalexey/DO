<package xmlns="http://v8.1c.ru/8.1/xdto" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://v8.1c.ru/edi/AB_edi_stnd/EnterpriseData/1.17">
	<import namespace="http://v8.1c.ru/edi/edi_stnd/EnterpriseData/1.17"/>
	<import namespace="http://www.1c.ru/SSL/Exchange/Message"/>
	<valueType xmlns:d2p1="http://www.1c.ru/SSL/Exchange/Message" name="СправочникСсылка.Сотрудники" base="d2p1:Ref"/>
	<objectType xmlns:d2p1="http://www.1c.ru/SSL/Exchange/Message" name="КлючевыеСвойстваСотрудники" base="d2p1:Object">
		<property xmlns:d3p1="http://v8.1c.ru/edi/AB_edi_stnd/EnterpriseData/1.17" name="Ссылка" type="d3p1:СправочникСсылка.Сотрудники"/>
		<property name="Наименование" type="xs:string"/>
		<property xmlns:d3p1="http://v8.1c.ru/edi/edi_stnd/EnterpriseData/1.17" name="Владелец" type="d3p1:КлючевыеСвойстваФизическоеЛицо"/>
	</objectType>
	<objectType xmlns:d2p1="http://www.1c.ru/SSL/Exchange/Message" name="Справочник.Сотрудники" base="d2p1:Object">
		<property xmlns:d3p1="http://v8.1c.ru/edi/AB_edi_stnd/EnterpriseData/1.17" name="КлючевыеСвойства" type="d3p1:КлючевыеСвойстваСотрудники"/>
		<property xmlns:d3p1="http://v8.1c.ru/edi/edi_stnd/EnterpriseData/1.17" name="Должность" type="d3p1:КлючевыеСвойстваДолжности"/>
		<property name="Подразделение" type="xs:string"/>
	</objectType>
	<objectType xmlns:d2p1="http://www.1c.ru/SSL/Exchange/Message" name="Справочник.РегистрацииВНалоговомОргане" base="d2p1:Object" open="true" sequenced="true">
		<property xmlns:d3p1="http://v8.1c.ru/edi/edi_stnd/EnterpriseData/1.17" name="КлючевыеСвойства" type="d3p1:КлючевыеСвойстваРегистрацияВНалоговомОргане"/>
		<property name="КраткоеНаименованиеНалоговогоОргана" type="xs:string"/>
		<property name="НаименованиеИФНС" type="xs:string"/>
		<property name="Представитель" lowerBound="0">
			<typeDef xsi:type="ObjectType" ordered="false">
				<property xmlns:d5p1="http://v8.1c.ru/edi/edi_stnd/EnterpriseData/1.17" name="Контрагент" type="d5p1:КлючевыеСвойстваКонтрагент" lowerBound="0"/>
				<property xmlns:d5p1="http://v8.1c.ru/edi/edi_stnd/EnterpriseData/1.17" name="ФизическоеЛицо" type="d5p1:КлючевыеСвойстваФизическоеЛицо" lowerBound="0"/>
			</typeDef>
		</property>
		<property name="УполномоченноеЛицоПредставителя" type="xs:string" lowerBound="0"/>
		<property name="ДокументПредставителя" type="xs:string" lowerBound="0"/>
		<property name="Доверенность" type="xs:string" lowerBound="0"/>
		<property xmlns:d3p1="http://v8.1c.ru/edi/edi_stnd/EnterpriseData/1.17" name="ОбщиеСвойстваОбъектовФормата" type="d3p1:ОбщиеСвойстваОбъектовФормата" lowerBound="0"/>
		<property name="ДатаПоставновкиНаУчет" type="xs:dateTime"/>
		<property name="ДатаСнятияСУчета" type="xs:dateTime"/>
		<property name="КодРегиона" type="xs:integer"/>
	</objectType>

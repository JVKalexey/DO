&После("ПередЗаписью")
Процедура АБ_ПередЗаписью(Отказ)
	//++dar 17.02.26 (309302)
	//++GIV 31032026 (320030)
	//Наименование формируется исходя из номера и даты регистрации, они должны быть заполнены раньше
	//Если НЕ ЗначениеЗаполнено(ДатаРегистрации) Тогда
	//	ДатаРегистрации = ТекущаяДатаСеанса();
	//КонецЕсли;
	//
	//Если НЕ ЗначениеЗаполнено(РегистрационныйНомер) Тогда
	//	УВМ_ЗаполнитьРегистрационныйНомер();
	//КонецЕсли;               
	//--GIV 31032026 (320030)
	
	Если ФормаДокумента = Перечисления.ВариантыФормДокументов.Бумажная Тогда
		Для Каждого ТекСторона Из Стороны Цикл
			Если ТипЗнч(ТекСторона.Сторона) = Тип("СправочникСсылка.Контрагенты") И НЕ ЗначениеЗаполнено(ТекСторона.УВМ_Почта) Тогда
				ТекстИсключения = НСтр("ru = 'В таблице ""Стороны"" не заполнен email контрагента.'");
				ВызватьИсключение ТекстИсключения;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// добавляем новую почту контрагенту / контактному лицу
	ТекКонтрагент = Неопределено;
	ТекКонтактноеЛицо = Неопределено;
	РезультатСсылка = Неопределено;
	ТекПочты = "";
	Для Каждого ТекСторона Из Стороны Цикл
		Если ТипЗнч(ТекСторона.Сторона) = Тип("СправочникСсылка.Контрагенты") Тогда
			ТекКонтрагент = ТекСторона.Сторона;
			ТекКонтактноеЛицо = ТекСторона.КонтактноеЛицо;
			ТекПочты = ТекСторона.УВМ_Почта;
		КонецЕсли;
	КонецЦикла;
	
	МсвНовыеПочты = СтрРазделить(СтрЗаменить(ТекПочты, " ", ""), ", ", Ложь);
	МсвУжеЕстьПочты = Новый Массив;
	
	ПочтыКонтрагента = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(ТекКонтрагент, Справочники.ВидыКонтактнойИнформации.EmailКонтрагента, , ТекущаяДатаСеанса());
	МсвПочтыКонтрагента = СтрРазделить(СтрЗаменить(ПочтыКонтрагента, " ", ""), ",", Ложь);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МсвУжеЕстьПочты, МсвПочтыКонтрагента, Истина);

	ПочтыКонтактногоЛица = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(ТекКонтактноеЛицо, Справочники.ВидыКонтактнойИнформации.EmailКонтактногоЛица, , ТекущаяДатаСеанса());
	МсвПочтыКонтактногоЛица = СтрРазделить(СтрЗаменить(ПочтыКонтактногоЛица, " ", ""), ",", Ложь);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МсвУжеЕстьПочты, МсвПочтыКонтактногоЛица, Истина);
	
	МсвДобавитьПочту = ОбщегоНазначенияКлиентСервер.РазностьМассивов(МсвНовыеПочты, МсвУжеЕстьПочты);
	
	УстановитьПривилегированныйРежим(Истина);
	Для Каждого ТекПочта Из МсвДобавитьПочту Цикл
		Если ЗначениеЗаполнено(ТекКонтактноеЛицо) Тогда
			УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(ТекКонтактноеЛицо, ТекПочта, Справочники.ВидыКонтактнойИнформации.EmailКонтактногоЛица, ТекущаяДатаСеанса(), Ложь);
		ИначеЕсли ЗначениеЗаполнено(ТекКонтрагент) Тогда
			УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(ТекКонтрагент, ТекПочта, Справочники.ВидыКонтактнойИнформации.EmailКонтрагента, ТекущаяДатаСеанса(), Ложь);
		КонецЕсли;
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	//--dar 17.02.26 (309302)
КонецПроцедуры

//++dar 17.02.26 (309302)
Процедура УВМ_ЗаполнитьРегистрационныйНомер()
	Нумератор = Нумерация.ПолучитьНумераторДокумента(ЭтотОбъект);
	Если Нумерация.ПроверитьСменуПериодаНумерации(ЭтотОбъект.ДатаРегистрации, Дата(1,1,1), Нумератор) Тогда 
		СформироватьЧисловойНомерДокумента(ЭтотОбъект);
		СформироватьСтроковыйНомерДокумента(ЭтотОбъект);
	Иначе
		СформироватьСтроковыйНомерДокумента(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

Процедура СформироватьЧисловойНомерДокумента(ТекущийОбъект)
	
	// сделал пустыми
	ПерепискаПоПредмету = Справочники.ДокументыПредприятия.ПустаяСсылка();
	НеДействуетВСоответствии = Справочники.ДокументыПредприятия.ПустаяСсылка();
	СвязанныйДокументДляНумерации = Справочники.ДокументыПредприятия.ПустаяСсылка();
	ВОтветНа = Справочники.ДокументыПредприятия.ПустаяСсылка();
	//
	
	СтруктураПараметров = НумерацияКлиентСервер.ПолучитьПараметрыНумерации(ТекущийОбъект);
	СтруктураПараметров.Вставить("ПерепискаПоПредмету",	ПерепискаПоПредмету);
	СтруктураПараметров.Вставить("НеДействуетВСоответствии", НеДействуетВСоответствии);
	СтруктураПараметров.Вставить("СвязанныйОбъект", СвязанныйДокументДляНумерации);
	СтруктураПараметров.Вставить("ПолученВОтветНа", ВОтветНа);
	
	Нумерация.СформироватьЧисловойНомерДокумента(СтруктураПараметров, ТекущийОбъект.ЧисловойНомер);
	
КонецПроцедуры

Процедура СформироватьСтроковыйНомерДокумента(ТекущийОбъект)
	
	// сделал пустыми
	ПерепискаПоПредмету = Справочники.ДокументыПредприятия.ПустаяСсылка();
	НеДействуетВСоответствии = Справочники.ДокументыПредприятия.ПустаяСсылка();
	СвязанныйДокументДляНумерации = Справочники.ДокументыПредприятия.ПустаяСсылка();
	ВОтветНа = Справочники.ДокументыПредприятия.ПустаяСсылка();
	//
	
	СтруктураПараметров = НумерацияКлиентСервер.ПолучитьПараметрыНумерации(ТекущийОбъект);
	СтруктураПараметров.Вставить("ПерепискаПоПредмету",	ПерепискаПоПредмету);
	СтруктураПараметров.Вставить("НеДействуетВСоответствии", НеДействуетВСоответствии);
	СтруктураПараметров.Вставить("СвязанныйОбъект", СвязанныйДокументДляНумерации);
	СтруктураПараметров.Вставить("ПолученВОтветНа", ВОтветНа);
	
	ОписанияОшибок = Новый СписокЗначений;
	Нумерация.СформироватьСтроковыйНомерДокумента(СтруктураПараметров, ТекущийОбъект.РегистрационныйНомер, ОписанияОшибок);
	
	Для Каждого ОписаниеОшибки Из ОписанияОшибок Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			ОписаниеОшибки.Представление,,
			ОписаниеОшибки.Значение,
			"Объект");
	КонецЦикла;
	
КонецПроцедуры


&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	//++dar 18.03.26 (317077)
	Если Объект.УВМ_НалогообложениеНДСОпределяетсяВДокументе Тогда
		ЭтотОбъект.РежимНалогообложения = 1;
	Иначе
		ЭтотОбъект.РежимНалогообложения = 0;
	КонецЕсли;
	
	УВМ_УстановитьСписокВыбораНалогообложенияНДС();

	УстановитьСвойстваЭлементовНалогообложенияИРаздельногоУчетаНДС(ЭтотОбъект.ТипДоговораЕРП);
	//--dar 18.03.26 (317077)
КонецПроцедуры

//++dar 18.03.26 (317077)
&НаСервере
Процедура ЗаполнитьСписокСтавокНДС(ПолеФормыСтавкаНДС)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтавкиНДС.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СтавкиНДС КАК СтавкиНДС
	|ГДЕ
	|	НЕ СтавкиНДС.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПолеФормыСтавкаНДС.СписокВыбора.Добавить(Выборка.Ссылка);
	КонецЦикла;
КонецПроцедуры
//--dar 18.03.26 (317077)

&НаКлиенте
&ИзменениеИКонтроль("СтороныПриАктивизацииЯчейки")
Процедура АБ_СтороныПриАктивизацииЯчейки(Элемент)

	ТекущиеДанные = Элементы.Стороны.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	РаботаСПодписямиДокументовКлиент.СтороныПриАктивизацииЯчейки(ЭтаФорма, Элементы, ТекущиеДанные);
	#Вставка
	//++GIV 02042026 (320030)
	Если ТипЗнч(ТекущиеДанные.Сторона) = Тип("СправочникСсылка.Организации") И ЗначениеЗаполнено(ТекущиеДанные.Сторона) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СтороныПодписал", "КнопкаВыбора", Ложь);
		Элементы.СтороныПодписал.КнопкаВыбора = Ложь;
		Элементы.СтороныПодписал.КнопкаВыпадающегоСписка = Истина;
		Элементы.СтороныПодписал.КнопкаСоздания = Ложь;
		Элементы.СтороныПодписал.СписокВыбора.ЗагрузитьЗначения(ВозможныеПодписантыОрганизации(ТекущиеДанные.Сторона, Объект.Тематика, Объект.Ответственный));
	Иначе
		Элементы.СтороныПодписал.КнопкаВыбора = Истина;
		Элементы.СтороныПодписал.КнопкаСоздания = Неопределено;
		Элементы.СтороныПодписал.СписокВыбора.Очистить();
	КонецЕсли;
	//--GIV 02042026 (320030)
    #КонецВставки
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВозможныеПодписантыОрганизации(Организация, Тематика, Ответственный)
	
	//++dar 06.05.26 (327054)
	МассивПодписантов = Новый Массив;
	Если НЕ ЗначениеЗаполнено(Ответственный) Тогда
		Возврат МассивПодписантов;
	КонецЕсли;
	
	Подразделение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ответственный, "Подразделение");
	Если НЕ ЗначениеЗаполнено(Подразделение) Тогда
		Возврат МассивПодписантов;
	КонецЕсли;
	
	ЭтоВходящий = Ложь;
	Если ЗначениеЗаполнено(Тематика) Тогда
		ЭтоВходящий = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Тематика, "АБ_ВходящиеДокументы");
	КонецЕсли;
	
	МассивПодразделений = Новый Массив;
	ТекущееПодразделение = Подразделение;
	Пока ЗначениеЗаполнено(ТекущееПодразделение) Цикл
		МассивПодразделений.Добавить(ТекущееПодразделение);
		ТекущееПодразделение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущееПодразделение, "Родитель");
	КонецЦикла;
	Если МассивПодразделений.Количество() = 0 Тогда
		Возврат МассивПодписантов;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|    СтруктураПредприятия.Ссылка КАК Подразделение,
	|    СтруктураПредприятия.Руководитель КАК Руководитель
	|ПОМЕСТИТЬ втПодразделения
	|ИЗ
	|    Справочник.СтруктураПредприятия КАК СтруктураПредприятия
	|ГДЕ
	|    СтруктураПредприятия.Ссылка В (&МассивПодразделений)
	|    И СтруктураПредприятия.Руководитель <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|    втПодразделения.Руководитель КАК Сотрудник
	|ПОМЕСТИТЬ втПодписанты
	|ИЗ
	|    втПодразделения КАК втПодразделения
	|        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
	|        ПО втПодразделения.Руководитель = Сотрудники.Ссылка
	|        ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АБ_ПраваИОснованияПравилПодписиДокументов КАК Права
	|        ПО Сотрудники.Владелец = Права.ФизическоеЛицо
	|ГДЕ
	|    Сотрудники.Действует
	|    И НЕ Сотрудники.ПометкаУдаления
	|    И Права.Организация = &Организация
	|    И (&ЭтоВходящий
	|            И Права.ПравоПодписиВходящихДокументов
	|        ИЛИ НЕ &ЭтоВходящий
	|            И Права.ПравоПодписиИсходящихДокументов)
	|
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Сотрудники.Ссылка
	|ИЗ
	|	втПодразделения КАК втПодразделения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
	|		ПО втПодразделения.Подразделение = Сотрудники.Подразделение
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АБ_ПраваИОснованияПравилПодписиДокументов КАК Права
	|		ПО (Сотрудники.Владелец = Права.ФизическоеЛицо)
	|ГДЕ
	|	Сотрудники.Действует
	|	И НЕ Сотрудники.ПометкаУдаления
	|	И Права.Организация = &Организация
	|	И (&ЭтоВходящий
	|				И Права.ПравоПодписиВходящихДокументов
	|			ИЛИ НЕ &ЭтоВходящий
	|				И Права.ПравоПодписиИсходящихДокументов)
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ 
	|	Сотрудники.Ссылка
	|ИЗ
	|	РегистрСведений.ОсновныеСотрудники КАК ОсновныеСотрудники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
	|		ПО (ОсновныеСотрудники.Сотрудник = Сотрудники.Ссылка)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.АБ_ОтветственныеЛицаОрганизаций КАК АБ_ОтветственныеЛицаОрганизаций
	|		ПО (ОсновныеСотрудники.ФизическоеЛицо = АБ_ОтветственныеЛицаОрганизаций.ФизическоеЛицо)
	|ГДЕ
	|	АБ_ОтветственныеЛицаОрганизаций.Владелец = &Организация
	|	И АБ_ОтветственныеЛицаОрганизаций.ОтветственноеЛицо = ""Руководитель""
	|	И АБ_ОтветственныеЛицаОрганизаций.ДолжностьСсылка = &ДолжностьДиректор
	|	И АБ_ОтветственныеЛицаОрганизаций.ДатаНачала < &ТекущаяДата
	|	И ВЫБОР
	|			КОГДА АБ_ОтветственныеЛицаОрганизаций.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА ДАТАВРЕМЯ(2500, 1, 1)
	|			ИНАЧЕ АБ_ОтветственныеЛицаОрганизаций.ДатаОкончания
	|		КОНЕЦ > &ТекущаяДата
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	| ОтветственныеЛица.Сотрудник
	|ИЗ
	| РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(, Организация = &Организация) КАК ОтветственныеЛица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	| втПодписанты.Сотрудник КАК Сотрудник
	|ИЗ
	| втПодписанты КАК втПодписанты
	|
	|УПОРЯДОЧИТЬ ПО
	| Сотрудник.Наименование";	
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ДолжностьДиректор", СокрЛП(АБ_ВызовСервера.ЗначениеКонстантыИзРегистра(Новый Структура("Ключ","Должность_Директор"),Неопределено)));
	Запрос.УстановитьПараметр("МассивПодразделений", МассивПодразделений);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ЭтоВходящий", ЭтоВходящий);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивПодписантов.Добавить(Выборка.Сотрудник);
	КонецЦикла;
	
	Возврат МассивПодписантов;
	//--dar 06.05.26 (327054)

КонецФункции

&НаКлиенте
&ИзменениеИКонтроль("СтороныПодписалОбработкаВыбора")
Процедура АБ_СтороныПодписалОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ТекущиеДанные = Элементы.Стороны.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;

	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Сотрудники") Тогда

		Если Не ЗначениеЗаполнено(ТекущиеДанные.Сторона)
			ИЛИ (ЗначениеЗаполнено(ТекущиеДанные.Сторона) И ТипЗнч(ТекущиеДанные.Сторона) = Тип("СправочникСсылка.Контрагенты")) Тогда
			ТекущиеДанные.Сторона = РаботаСОрганизациями.ОрганизацияПоУмолчанию();
		КонецЕсли;	

		ТекущиеДанные.Подписал = ВыбранноеЗначение;   
		#Вставка
		//++GIV 03042026 (320030)
		ТекущиеДанные.УВМ_Основание = "";
		//--GIV 03042026 (320030)
		#КонецВставки

	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.КонтактныеЛица") Тогда

		Контрагент = ОбщегоНазначенияДокументооборотВызовСервера.ЗначениеРеквизитаОбъекта(ВыбранноеЗначение, "Владелец");
		Если Не ЗначениеЗаполнено(ТекущиеДанные.Сторона)
			ИЛИ Контрагент <> ТекущиеДанные.Сторона Тогда
			ТекущиеДанные.Сторона = Контрагент;
		КонецЕсли;
		ТекущиеДанные.Подписал = ВыбранноеЗначение;

	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("Строка") Тогда

		Если РаботаСПодписямиДокументовКлиентСервер.ЭтоОрганизация(ТекущиеДанные.Сторона)
			И ПодписантыИзДействий.Количество() Тогда
			Возврат;
		КонецЕсли;

		ТекущиеДанные.Подписал = ВыбранноеЗначение;

	КонецЕсли;

	Модифицированность = Истина;

	УстановитьПараметрыТаблицыСтороны(ТекущиеДанные);

КонецПроцедуры

&НаКлиенте
&ИзменениеИКонтроль("СтороныПодписалАвтоПодбор")
Процедура АБ_СтороныПодписалАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	#Вставка
	//++GIV 03042026 (320030)
	ТекущиеДанные = Элементы.Стороны.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ТипЗнч(ТекущиеДанные.Сторона) = Тип("СправочникСсылка.Организации") Тогда
		СтандартнаяОбработка = Ложь;
		Текст = "";		
		Возврат;
	КонецЕсли;
	//--GIV 03042026 (320030)
	#КонецВставки
	СтороныПодписалАвтоПодборОкончаниеВводаТекста(Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
&После("ДействияОтправитьЗавершение")
Процедура АБ_ДействияОтправитьЗавершение(Результат, Параметры)

	//++dar 17.04.26 (323881)
	Если Результат.Свойство("ПрерванПроцесс") И Результат.ПрерванПроцесс Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Тематика) Тогда
		РеквизитыТематики = ОбщегоНазначенияДокументооборотВызовСервера.ЗначенияРеквизитовОбъекта(Объект.Тематика, "УВМ_ОтправитьДоговорКонтрагенту, УВМ_СформироватьДоговорВЕРП");
		
		Если РеквизитыТематики.УВМ_СформироватьДоговорВЕРП Тогда
			АБ_ВызовСервера.СоздатьДоговорВоВнешнейБазе(Объект.Ссылка);
		КонецЕсли;
		
		Если Объект.ФормаДокумента = ПредопределенноеЗначение("Перечисление.ВариантыФормДокументов.Бумажная") И РеквизитыТематики.УВМ_ОтправитьДоговорКонтрагенту Тогда
			УВМ_ОбщиеДоработкиКлиент.УВМ_ПрикрепитьФайлPDF(Объект.Ссылка);
			УВМ_ОбщиеДоработкиКлиент.УВМ_СформироватьИОтправитьПисьмаКлиентам(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Ссылка));			
		КонецЕсли;
	КонецЕсли; 
	//--dar 17.04.26 (323881)
	
КонецПроцедуры
#КонецОбласти

	//++dar 16.04.26 (323545)
	УВМ_РеквизитыФайлов.Вставить("УВМ_ЕстьКопия", УВМ_РаботаСФормами.ОписаниеТипаБулево());
	УВМ_РеквизитыФайлов.Вставить("УВМ_ЕстьОригинал", УВМ_РаботаСФормами.ОписаниеТипаБулево());
	//--dar 16.04.26 (323545)

	Если Объект.Ссылка.Пустая() Тогда 
		Объект.УВМ_ТипНеустойки = Перечисления.УВМ_ТипыНеустойки.КоммерческийКредит;
		Объект.ФормаДокумента = Перечисления.ВариантыФормДокументов.ПустаяСсылка();
	КонецЕсли;
	
	//++dar 22.04.26 (324174)
	СвойстваВариантДоговора = Новый Структура("РежимВыбораИзСписка, АвтоОтметкаНезаполненного", Истина, Истина);

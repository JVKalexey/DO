&НаСервере
Функция ПолучитьДанныеВыбораСтороныОснование(пСторона,пНаименованиеСтороны,пПодписал)
	
	СписокВозврат = Новый СписокЗначений;
	
	//++GIV 31032026 (320030)
	//Если спрСсылка.Сотрудники тогда По ответственным лицам организации ИНАЧЕ по УВМ_ОснованиеПодписи
	Если ТипЗнч(пПодписал) = Тип("СправочникСсылка.Сотрудники") И ТипЗнч(пСторона) = Тип("СправочникСсылка.Организации") Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Тематика", Объект.Тематика);
		Запрос.УстановитьПараметр("Организация", пСторона);
		Запрос.УстановитьПараметр("Сотрудник", пПодписал);
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ТематикиДокументов.АБ_ВходящиеДокументы КАК ВходящийДокумент
		               |ПОМЕСТИТЬ ВТВходящийДокумент
		               |ИЗ
		               |	Справочник.ТематикиДокументов КАК ТематикиДокументов
		               |ГДЕ
		               |	ТематикиДокументов.Ссылка = &Тематика
		               |
		               |ИНДЕКСИРОВАТЬ ПО
		               |	ВходящийДокумент
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	АБ_ПраваИОснованияПравилПодписиДокументов.НомерДокументаПраваПодписи КАК НомерДокументаПраваПодписи,
		               |	АБ_ПраваИОснованияПравилПодписиДокументов.ДатаДокументаПраваПодписи КАК ДатаДокументаПраваПодписи,
		               |	АБ_ПраваИОснованияПравилПодписиДокументов.ДокументПраваПодписи КАК ДокументПраваПодписи,
		               |	Сотрудники.Должность КАК Должность,
		               |	Сотрудники.ПредставлениеВДокументах КАК ПредставлениеВДокументах
		               |ИЗ
		               |	РегистрСведений.АБ_ПраваИОснованияПравилПодписиДокументов КАК АБ_ПраваИОснованияПравилПодписиДокументов
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
		               |		ПО АБ_ПраваИОснованияПравилПодписиДокументов.ФизическоеЛицо = Сотрудники.Владелец
		               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТВходящийДокумент КАК ВТВходящийДокумент
		               |		ПО (ИСТИНА)
		               |ГДЕ
		               |	АБ_ПраваИОснованияПравилПодписиДокументов.Организация = &Организация
		               |	И Сотрудники.Действует
		               |	И НЕ Сотрудники.ПометкаУдаления
		               |	И ВЫБОР
		               |			КОГДА ВТВходящийДокумент.ВходящийДокумент
		               |					И АБ_ПраваИОснованияПравилПодписиДокументов.ПравоПодписиВходящихДокументов
		               |				ТОГДА ИСТИНА
		               |			ИНАЧЕ ВЫБОР
		               |					КОГДА НЕ ВТВходящийДокумент.ВходящийДокумент
		               |							И АБ_ПраваИОснованияПравилПодписиДокументов.ПравоПодписиИсходящихДокументов
		               |						ТОГДА ИСТИНА
		               |					ИНАЧЕ ЛОЖЬ
		               |				КОНЕЦ
		               |		КОНЕЦ
		               |	И Сотрудники.Ссылка = &Сотрудник"; 
		Выборка = Запрос.Выполнить().Выбрать();
		мДолжностей = ДолжностиДляОснованияУстав();
		Пока Выборка.Следующий() Цикл
			//++dar 22.05.26 (330168)
			//Если мДолжностей.Найти(Выборка.Должность) = Неопределено Тогда 
			//	СписокВозврат.Добавить(СтрШаблон("%1 %2, %3 %4 от %5", Выборка.Должность, 
			//	Выборка.ПредставлениеВДокументах, 
			//	?(ЗначениеЗаполнено(Выборка.ДокументПраваПодписи),Выборка.ДокументПраваПодписи, "Документ права подписи не заполнен"), 
			//	?(ЗначениеЗаполнено(Выборка.НомерДокументаПраваПодписи),Выборка.НомерДокументаПраваПодписи, "Номер документа права подписи не заполнен"),
			//	?(ЗначениеЗаполнено(Выборка.ДатаДокументаПраваПодписи), Формат(Выборка.ДатаДокументаПраваПодписи, "ДЛФ=DD"), 
			//	"Дата документа права подписи не заполнена")));
			//Иначе
			//	СписокВозврат.Добавить(СтрШаблон("%1 %2 Устав", Выборка.Должность, 
			//	Выборка.ПредставлениеВДокументах));
			//КонецЕсли;
			Если мДолжностей.Найти(Выборка.Должность) = Неопределено Тогда
				СписокВозврат.Добавить(СтрШаблон("%1 %2 от %3",
				?(ЗначениеЗаполнено(Выборка.ДокументПраваПодписи), Выборка.ДокументПраваПодписи, "Документ права подписи не заполнен"),
				?(ЗначениеЗаполнено(Выборка.НомерДокументаПраваПодписи), Выборка.НомерДокументаПраваПодписи, "Номер документа права подписи не заполнен"),
				?(ЗначениеЗаполнено(Выборка.ДатаДокументаПраваПодписи), Формат(Выборка.ДатаДокументаПраваПодписи, "ДЛФ=DD"),
				"Дата документа права подписи не заполнена")));
			Иначе
				СписокВозврат.Добавить("Устав");
			КонецЕсли;
			//--dar 22.05.26 (330168)
		КонецЦикла;
	ИначеЕсли ТипЗнч(пПодписал) = Тип("СправочникСсылка.КонтактныеЛица") И ТипЗнч(пСторона) = Тип("СправочникСсылка.Контрагенты") Тогда
		ОснованиеПодписиКЛ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(пПодписал,"УВМ_ОснованиеПодписи");
		Если ЗначениеЗаполнено(ОснованиеПодписиКЛ) тогда
			СписокВозврат.Добавить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(пПодписал,"УВМ_ОснованиеПодписи"));
		КонецЕсли;
	КонецЕсли;
	
	Возврат СписокВозврат;
	//--GIV 06042026 (320030)
КонецФункции  

&НаСервереБезКонтекста
Функция ДолжностиДляОснованияУстав()
	мДолжностей = Новый Массив;
	мДолжностей.Добавить(АБ_ВызовСервера.ЗначениеКонстантыИзРегистра(Новый Структура("Ключ","Должность_директор"),Справочники.Должности.ПустаяСсылка()));
	мДолжностей.Добавить(АБ_ВызовСервера.ЗначениеКонстантыИзРегистра(Новый Структура("Ключ","Должность_ген_директор"),Справочники.Должности.ПустаяСсылка()));
	Возврат мДолжностей;
КонецФункции

&НаСервере
Процедура УВМ_СоздатьСтруктуруКонстант()
	
	ДобРеквизиты = Новый Массив;
	НовРеквизит = Новый РеквизитФормы("СтруктураКонстантУВМ",Новый ОписаниеТипов());
	ДобРеквизиты.Добавить(НовРеквизит);
	ЭтаФорма.ИзменитьРеквизиты(ДобРеквизиты);	
	СтруктураКонстант = Новый Структура();
	ВидДокумента10_МыПоставщик  = АБ_ВызовСервера.ЗначениеКонстантыИзРегистра(Новый Структура("Ключ","ВД_ДоговорПоставкиМыПоставщик"),Неопределено);
	Если ЗначениеЗаполнено(ВидДокумента10_МыПоставщик) тогда
		СтруктураКонстант.Вставить("ВД_ДоговорПоставкиМыПоставщик",ВидДокумента10_МыПоставщик);
	КонецЕсли;
	НаименованиеСтрон_Покупатель = АБ_ВызовСервера.ЗначениеКонстантыИзРегистра(Новый Структура("Ключ","Сторона_Покупатель"),Неопределено);
	Если ЗначениеЗаполнено(НаименованиеСтрон_Покупатель) тогда
		СтруктураКонстант.Вставить("Сторона_Покупатель",НаименованиеСтрон_Покупатель);
	КонецЕсли;
	НаименованиеСтрон_Поставщик  = АБ_ВызовСервера.ЗначениеКонстантыИзРегистра(Новый Структура("Ключ","Сторона_Поставщик"),Неопределено);
	Если ЗначениеЗаполнено(НаименованиеСтрон_Поставщик) тогда
		СтруктураКонстант.Вставить("Сторона_Поставщик",НаименованиеСтрон_Поставщик);
	КонецЕсли;
	Должность_Директор  = АБ_ВызовСервера.ЗначениеКонстантыИзРегистра(Новый Структура("Ключ","Должность_Директор"),Неопределено);
	Если ЗначениеЗаполнено(Должность_Директор) тогда
		СтруктураКонстант.Вставить("Должность_Директор",Строка(Должность_Директор));
	КонецЕсли;
	ЭтаФорма.СтруктураКонстантУВМ = СтруктураКонстант;
	
КонецПроцедуры

&НаСервере
Процедура УВМ_ТЧСтороныУказатьОснованиеСтроки(пДанныеСтроки)
	Если ТипЗнч(пДанныеСтроки) = Тип("Число") тогда
		ТекущиеДанные = Объект.Стороны.НайтиПоИдентификатору(пДанныеСтроки);
	Иначе
		ТекущиеДанные = пДанныеСтроки;
	КонецЕсли;
	Если ТекущиеДанные = Неопределено тогда
		Возврат;
	КонецЕсли;
	
	СписокВыбора = ПолучитьДанныеВыбораСтороныОснование(ТекущиеДанные.Сторона,ТекущиеДанные.Наименование,ТекущиеДанные.Подписал);
	Если СписокВыбора.Количество()>0 тогда
		Если СписокВыбора.НайтиПоЗначению(ТекущиеДанные.УВМ_Основание)=Неопределено тогда
			ТекущиеДанные.УВМ_Основание = СписокВыбора[0].Значение;
		КонецЕсли;
	Иначе
		ТекущиеДанные.УВМ_Основание = Неопределено;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УВМ_ТЧСтороныУказатьПодписавшего(пДанныеСтроки)
	Если ТипЗнч(пДанныеСтроки) = Тип("Число") тогда
		ТекущиеДанные = Объект.Стороны.НайтиПоИдентификатору(пДанныеСтроки);
	Иначе
		ТекущиеДанные = пДанныеСтроки;
	КонецЕсли;
	Если ТекущиеДанные = Неопределено тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Подписал) или Не ЗначениеЗаполнено(ТекущиеДанные.Сторона) тогда
		Возврат;
	КонецЕсли;
	
	Если  ЭтаФорма.СтруктураКонстантУВМ.Свойство("ВД_ДоговорПоставкиМыПоставщик") 
		и Объект.ВидДокумента = ЭтаФорма.СтруктураКонстантУВМ.ВД_ДоговорПоставкиМыПоставщик тогда
		
		Если ЭтаФорма.СтруктураКонстантУВМ.Свойство("Сторона_Покупатель") 
			и ТекущиеДанные.Наименование = ЭтаФорма.СтруктураКонстантУВМ.Сторона_Покупатель тогда
			
			Запрос = Новый Запрос();
			Запрос.УстановитьПараметр("Контрагент",ТекущиеДанные.Сторона);
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ 
			|	КонтактныеЛица.Ссылка КАК КонтактноеЛицоСсылка
			|ИЗ
			|	Справочник.КонтактныеЛица КАК КонтактныеЛица
			|ГДЕ
			|	КонтактныеЛица.Владелец=&Контрагент И КонтактныеЛица.УВМ_ОснованиеПодписи <> """" ";
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() тогда
				ТекущиеДанные.Подписал = Выборка.КонтактноеЛицоСсылка;
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(Объект.Подразделение)
			и ЭтаФорма.СтруктураКонстантУВМ.Свойство("Должность_Директор")
			и ЭтаФорма.СтруктураКонстантУВМ.Свойство("Сторона_Поставщик") 
			и ТекущиеДанные.Наименование = ЭтаФорма.СтруктураКонстантУВМ.Сторона_Поставщик тогда
			
			Запрос = Новый Запрос();
			Запрос.УстановитьПараметр("Организация",ТекущиеДанные.Сторона);
			Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДатаСеанса());
			Запрос.УстановитьПараметр("ДолжностьДиректор",ЭтаФорма.СтруктураКонстантУВМ.Должность_Директор);
			Запрос.УстановитьПараметр("Подразделение",Объект.Подразделение);
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Сотрудники.Ссылка КАК СотрудникСсылка
			|ИЗ
			|	РегистрСведений.ОсновныеСотрудники КАК ОсновныеСотрудники
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
			|		ПО (ОсновныеСотрудники.Сотрудник = Сотрудники.Ссылка)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.АБ_ОтветственныеЛицаОрганизаций КАК АБ_ОтветственныеЛицаОрганизаций
			|		ПО (ОсновныеСотрудники.ФизическоеЛицо = АБ_ОтветственныеЛицаОрганизаций.ФизическоеЛицо)
			|ГДЕ
			|	Сотрудники.Подразделение = &Подразделение
			|	И АБ_ОтветственныеЛицаОрганизаций.Владелец = &Организация
			|	И АБ_ОтветственныеЛицаОрганизаций.ЕстьПравоПодписиИсходящихДоговоров
			|	И АБ_ОтветственныеЛицаОрганизаций.ДатаНачала < &ТекущаяДата
			|	И ВЫБОР
			|			КОГДА АБ_ОтветственныеЛицаОрганизаций.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
			|				ТОГДА ДАТАВРЕМЯ(2500, 1, 1)
			|			ИНАЧЕ АБ_ОтветственныеЛицаОрганизаций.ДатаОкончания
			|		КОНЕЦ > &ТекущаяДата
			|
			|ОБЪЕДИНИТЬ ВСЕ 
			|
			|ВЫБРАТЬ 
			|	Сотрудники.Ссылка КАК СотрудникСсылка
			|ИЗ
			|	РегистрСведений.ОсновныеСотрудники КАК ОсновныеСотрудники
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
			|		ПО (ОсновныеСотрудники.Сотрудник = Сотрудники.Ссылка)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.АБ_ОтветственныеЛицаОрганизаций КАК АБ_ОтветственныеЛицаОрганизаций
			|		ПО (ОсновныеСотрудники.ФизическоеЛицо = АБ_ОтветственныеЛицаОрганизаций.ФизическоеЛицо)
			|ГДЕ
			|	АБ_ОтветственныеЛицаОрганизаций.Владелец = &Организация
			|	И АБ_ОтветственныеЛицаОрганизаций.ОтветственноеЛицо = ""Руководитель""
			|	И АБ_ОтветственныеЛицаОрганизаций.ДолжностьСсылка = &ДолжностьДиректор
			|	И АБ_ОтветственныеЛицаОрганизаций.ДатаНачала < &ТекущаяДата
			|	И ВЫБОР
			|			КОГДА АБ_ОтветственныеЛицаОрганизаций.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
			|				ТОГДА ДАТАВРЕМЯ(2500, 1, 1)
			|			ИНАЧЕ АБ_ОтветственныеЛицаОрганизаций.ДатаОкончания
			|		КОНЕЦ > &ТекущаяДата";
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() тогда
				ТекущиеДанные.Подписал = Выборка.СотрудникСсылка;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


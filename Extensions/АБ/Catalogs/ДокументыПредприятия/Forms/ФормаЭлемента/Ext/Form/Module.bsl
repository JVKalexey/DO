Процедура УВМ_УстановитьСписокВыбораНалогообложенияНДС()
	
	Если Объект.УВМ_НалогообложениеНДСОпределяетсяВДокументе Тогда
		Объект.УВМ_НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПустаяСсылка();
		Возврат;
	КонецЕсли;
	
	Элементы.УВМ_НалогообложениеНДС.СписокВыбора.Очистить();
	
	Если ЭтотОбъект.ТипДоговораЕРП = Перечисления.ТипыДоговоров.СПокупателем Тогда//Реализация
		Элементы.УВМ_НалогообложениеНДС.СписокВыбора.Добавить(Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС, "Продажа облагается НДС");

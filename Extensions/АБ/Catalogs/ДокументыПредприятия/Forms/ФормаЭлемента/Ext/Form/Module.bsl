Процедура АБ_ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	//++dar 29.04.26 (326008)
	ЕстьОригиналИлиКопия = Ложь;
	Для Каждого Строка Из Файлы.ПолучитьЭлементы() Цикл			
		Если Не Строка.ЭтоРольФайла И Не Строка.ЭтоДокументЭДО Тогда
			Если Строка.Оригинал ИЛИ Строка.УВМ_ЯвляетсяКопией Тогда
				ЕстьОригиналИлиКопия = Истина;
				Прервать;
			КонецЕсли;
			
		Иначе
			Для Каждого Подстрока Из Строка.ПолучитьЭлементы() Цикл
				Если Подстрока.Оригинал ИЛИ Подстрока.УВМ_ЯвляетсяКопией Тогда
					ЕстьОригиналИлиКопия = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ЕстьОригиналИлиКопия Тогда
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекущаяСторона Из ТекущийОбъект.Стороны Цикл
		ТекущаяСторона.Подписан = ЕстьОригиналИлиКопия;
	КонецЦикла;
	//--dar 29.04.26 (326008)

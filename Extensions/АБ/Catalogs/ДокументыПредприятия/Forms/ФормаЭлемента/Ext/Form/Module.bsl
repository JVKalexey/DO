																					Элементы.СрокДействияСтрока, , , , СвойстваГруппаСрокДействия);
	СвойстваДатаНачалаДействия = Новый Структура;
	СвойстваДатаНачалаДействия.Вставить("АвтоМаксимальнаяШирина", Истина);
	СвойстваДатаНачалаДействия.Вставить("АвтоМаксимальнаяВысота", Истина);
	УВМ_ДатаНачалаДействия = УВМ_РаботаСФормами.НовоеПоле(ЭтотОбъект, "ДатаНачалаДействия", УВМ_ГруппаСрокДействия, Истина, , , "Действует с", СвойстваДатаНачалаДействия);
	
	УВМ_РаботаСФормами.НовоеПоле(ЭтотОбъект, "ПорядокПродления", Элементы.ГруппаРеквизиты, Истина, , Элементы.СрокДействияСтрока, "Продление");
	//--срок действия договора
	
	УВМ_РаботаСФормами.НовоеПоле(ЭтотОбъект, "УВМ_КоличествоДнейОтсрочки", Элементы.ГруппаРеквизиты, Истина, , Элементы.СрокДействияСтрока, "Дней отсрочки");
	
	СвойстваГруппаНеустойка = Новый Структура("Группировка", ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда);

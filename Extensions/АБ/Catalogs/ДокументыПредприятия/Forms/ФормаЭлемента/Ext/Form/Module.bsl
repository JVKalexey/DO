	СвойстваЯвляетсяКопией = Новый Структура;
	СвойстваЯвляетсяКопией.Вставить("ПоложениеЗаголовка", ПоложениеЗаголовкаЭлементаФормы.Нет);
	СвойстваЯвляетсяКопией.Вставить("КартинкаШапки", БиблиотекаКартинок.СкопироватьВБуферОбмена);
	СвойстваЯвляетсяКопией.Вставить("Подсказка", "Копия");
	
	СобытияЯвляетсяКопией = Новый Структура("ПриИзменении", "УВМ_ЯвляетсяКопиейПриИзменении");
	
	УВМ_РаботаСФормами.НоваяКолонкаТаблицыФормы(ЭтотОбъект, "УВМ_ЯвляетсяКопиейСоздание", Элементы.ФайлыСоздание, "Файлы.УВМ_ЯвляетсяКопией", 2, "Копия", 
													Истина, Истина, СвойстваЯвляетсяКопией, СобытияЯвляетсяКопией, Элементы.ОригиналСоздание);
	
	УВМ_РаботаСФормами.НоваяКолонкаТаблицыФормы(ЭтотОбъект, "УВМ_ЯвляетсяКопией", Элементы.Файлы, "Файлы.УВМ_ЯвляетсяКопией", 2, "Копия", 
													Истина, Истина, СвойстваЯвляетсяКопией, СобытияЯвляетсяКопией, Элементы.Оригинал);
	Элементы.Оригинал.Подсказка = "Оригинал";
	Элементы.ОригиналСоздание.Подсказка = "Оригинал";
	//--dar 17.02.26 (309302)

КонецПроцедуры


//++dar 04.05.26 (326149)
Процедура УВМ_ПриИзмененииВидаДокумента()
	
	РеквизитыВидаДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ВидДокумента, "УВМ_ВариантыДоговоров, УВМ_ТипКонтрагента, УВМ_СкрыватьПолеТипНеустойки");
	ВыборкаВариантыДоговоров = РеквизитыВидаДокумента.УВМ_ВариантыДоговоров.Выбрать();
	Элементы.УВМ_ВариантДоговора.СписокВыбора.Очистить();
	
	Пока ВыборкаВариантыДоговоров.Следующий() Цикл
		Элементы.УВМ_ВариантДоговора.СписокВыбора.Добавить(ВыборкаВариантыДоговоров.ВариантДоговора);
	КонецЦикла;
	
	Если Элементы.УВМ_ВариантДоговора.СписокВыбора.Количество() = 0 Тогда
		Для Каждого ТекущийВариант Из Перечисления.УВМ_ВариантыДоговоров Цикл
			Элементы.УВМ_ВариантДоговора.СписокВыбора.Добавить(ТекущийВариант);
		КонецЦикла;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Параметры.Ключ) ИЛИ Элементы.УВМ_ВариантДоговора.СписокВыбора.НайтиПоЗначению(Объект.УВМ_ВариантДоговора) = Неопределено Тогда
		Объект.УВМ_ВариантДоговора = Неопределено;
		Если Элементы.УВМ_ВариантДоговора.СписокВыбора.Количество() = 1 Тогда
			Объект.УВМ_ВариантДоговора = Элементы.УВМ_ВариантДоговора.СписокВыбора[0].Значение;
		КонецЕсли;                                
	КонецЕсли;

	ЭтотОбъект.УВМ_ТипКонтрагента = РеквизитыВидаДокумента.УВМ_ТипКонтрагента;
	
	//++dar 01.06.26 (330575)
	Элементы.УВМ_ТипНеустойки.Видимость = НЕ (РеквизитыВидаДокумента.УВМ_СкрыватьПолеТипНеустойки = Истина);
	Элементы.УВМ_ПроцентНеустойки.Видимость = НЕ (РеквизитыВидаДокумента.УВМ_СкрыватьПолеТипНеустойки = Истина);
	//--dar 01.06.26 (330575)
	
КонецПроцедуры

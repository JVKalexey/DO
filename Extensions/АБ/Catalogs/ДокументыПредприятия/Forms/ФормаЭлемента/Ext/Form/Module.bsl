&НаСервере
Функция УВМ_ПочтыКонтрагентаИКонтактногоЛица(Контрагент, КонтактноеЛицо, УказанныеПочты)
	
	Результат = "";
	МсвРезультат = Новый Массив;
	
	МсвУказанныеПочты = СтрРазделить(СтрЗаменить(УказанныеПочты, " ", ""), ", ", Ложь);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МсвРезультат, МсвУказанныеПочты, Истина);
	
	ПочтыКонтрагента = УВМ_ЭлектронныеПочты(Контрагент);
	МсвПочтыКонтрагента = СтрРазделить(СтрЗаменить(ПочтыКонтрагента, " ", ""), ",", Ложь);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МсвРезультат, МсвПочтыКонтрагента, Истина);
	
	ПочтыКонтактногоЛица = УВМ_ЭлектронныеПочты(КонтактноеЛицо);
	МсвПочтыКонтактногоЛица = СтрРазделить(СтрЗаменить(ПочтыКонтактногоЛица, " ", ""), ",", Ложь);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МсвРезультат, МсвПочтыКонтактногоЛица, Истина);
	
	Результат = СтрСоединить(МсвРезультат, ", ");
	
	Возврат Результат;

КонецФункции

&НаСервере
Функция УВМ_ЭлектронныеПочты(СсылкаНаОбъект)
	
	Результат = "";
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.Контрагенты") Тогда
		Результат = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(СсылкаНаОбъект, Справочники.ВидыКонтактнойИнформации.EmailКонтрагента, , ТекущаяДатаСеанса());
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.КонтактныеЛица") Тогда
		Результат = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(СсылкаНаОбъект, Справочники.ВидыКонтактнойИнформации.EmailКонтактногоЛица, , ТекущаяДатаСеанса());
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

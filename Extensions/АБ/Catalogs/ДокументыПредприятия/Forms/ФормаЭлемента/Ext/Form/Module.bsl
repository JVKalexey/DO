															"Тип договора", СвойстваВариантДоговора, СобытияВариантДоговора);
	Если НЕ Параметры.Ключ.Пустая() Тогда
		УВМ_ПриИзмененииВидаДокумента();
	КонецЕсли;
	//--dar 22.04.26 (324174)

	// является копией

	ИначеЕсли ЭтотОбъект.ТипДоговораЕРП = Перечисления.ТипыДоговоров.СПоставщиком Тогда//Закупка
		Элементы.УВМ_НалогообложениеНДС.СписокВыбора.Добавить(Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС, "Закупка облагается НДС");
		Элементы.УВМ_НалогообложениеНДС.СписокВыбора.Добавить(Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС, "Закупка не облагается НДС");
		Элементы.УВМ_НалогообложениеНДС.СписокВыбора.Добавить(Перечисления.ТипыНалогообложенияНДС.НалоговыйАгентПоНДС, "Налоговый агент по НДС");
		
	ИначеЕсли ЭтотОбъект.ТипДоговораЕРП = Перечисления.ТипыДоговоров.ВвозИзЕАЭС Тогда//Закупка (ЕАЭС)
		
	ИначеЕсли ЭтотОбъект.ТипДоговораЕРП = Перечисления.ТипыДоговоров.СПереработчиком2_5 Тогда//Передача в переработку
		Элементы.УВМ_НалогообложениеНДС.СписокВыбора.Добавить(Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС, "Закупка облагается НДС");
		Элементы.УВМ_НалогообложениеНДС.СписокВыбора.Добавить(Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС, "Закупка не облагается НДС");
		
	ИначеЕсли ЭтотОбъект.ТипДоговораЕРП = Перечисления.ТипыДоговоров.СХранителем Тогда//Передача на ответственное хранение
		Элементы.УВМ_НалогообложениеНДС.СписокВыбора.Добавить(Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС, "Продажа облагается НДС");
		Элементы.УВМ_НалогообложениеНДС.СписокВыбора.Добавить(Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС, "Продажа не облагается НДС");
		Элементы.УВМ_НалогообложениеНДС.СписокВыбора.Добавить(Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДСУПокупателя, "Облагается НДС у покупателя");
		
	ИначеЕсли ЭтотОбъект.ТипДоговораЕРП = Перечисления.ТипыДоговоров.СДавальцем2_5 Тогда//Прием в переработку
		Элементы.УВМ_НалогообложениеНДС.СписокВыбора.Добавить(Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС, "Продажа облагается НДС");
		Элементы.УВМ_НалогообложениеНДС.СписокВыбора.Добавить(Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС, "Продажа не облагается НДС");
		Элементы.УВМ_НалогообложениеНДС.СписокВыбора.Добавить(Перечисления.ТипыНалогообложенияНДС.ПродажаНаЭкспорт, "Экспорт");
		
	ИначеЕсли ЭтотОбъект.ТипДоговораЕРП = Перечисления.ТипыДоговоров.СПоклажедателем Тогда//Прием на ответственное хранение
		Элементы.УВМ_НалогообложениеНДС.СписокВыбора.Добавить(Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС, "Закупка облагается НДС");
		Элементы.УВМ_НалогообложениеНДС.СписокВыбора.Добавить(Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС, "Закупка не облагается НДС");
		Элементы.УВМ_НалогообложениеНДС.СписокВыбора.Добавить(Перечисления.ТипыНалогообложенияНДС.НалоговыйАгентПоНДС, "Налоговый агент по НДС");

	КонецЕсли;


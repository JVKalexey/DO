&НаСервере
&После("ПриСозданииНаСервере")
Процедура АБ_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)	
	// +++ Миляев (293293) 2026-01-30
	ГруппаПодменю = УВМ_РаботаСФормами.НоваяГруппа(ЭтаФорма,"АБ_КП_Сервис",Элементы.ГруппаКоманднаяПанель
		,Новый Структура("Вид, Заголовок, ВажностьПриОтображении",ВидГруппыФормы.Подменю,"Сервис",ВажностьПриОтображении.ОченьНизкая));
	УВМ_РаботаСФормами.НоваяКоманда(ЭтаФорма, "АБ_СохранитьСкриптыВФайл", "Сохранить скрипты в файл", "АБ_СохранитьСкриптыВФайл");
	УВМ_РаботаСФормами.НоваяКнопка(ЭтаФорма , "АБ_СохранитьСкриптыВФайл", ГруппаПодменю, "Сохранить скрипты в файл", "АБ_СохранитьСкриптыВФайл");
	УВМ_РаботаСФормами.НоваяКоманда(ЭтаФорма, "АБ_ЗагрузитьСкриптыИзФайла", "Загрузить скрипты из файла", "АБ_ЗагрузитьСкриптыИзФайла");
	УВМ_РаботаСФормами.НоваяКнопка(ЭтаФорма , "АБ_ЗагрузитьСкриптыИзФайла", ГруппаПодменю, "Загрузить скрипты из файла", "АБ_ЗагрузитьСкриптыИзФайла");


&НаСервере
&После("ПриСозданииНаСервере")
Процедура АБ_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	//++dar 25.02.26 (309302)
	УВМ_РаботаСФормами.СоздатьРеквизит(ЭтотОбъект, "УВМ_ТекстПисьма", УВМ_РаботаСФормами.ОписаниеТипаСтрока());
	//--dar 25.02.26 (309302)                             
	
	//++dar 02.06.26 (330921)
	Если Объект.Ссылка.Пустая()
		И Параметры.Свойство("УВМ_ДокументКонтрагента")
		И ЗначениеЗаполнено(Параметры.УВМ_ДокументКонтрагента) Тогда
		
		УВМ_ЗаполнитьПисьмоПоДоговоруКонтрагента(Параметры.УВМ_ДокументКонтрагента);
	КонецЕсли;
	//--dar 02.06.26 (330921)
	
КонецПроцедуры            

//++dar 02.06.26 (330921)
&НаСервере
Процедура УВМ_ЗаполнитьПисьмоПоДоговоруКонтрагента(ДоговорКонтрагента)

	// 1. Связь письма с договором
	Объект.УВМ_ДокументОснованиеКонтрагент = ДоговорКонтрагента;

	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДоговорКонтрагента,
		"РегистрационныйНомер, ДатаРегистрации, ВременныйНомер, ДатаНачалаДействия");

	// 2. Тема письма формата: «Договор № [Номер] от [Дата]»
	НомерДоговора = ?(ЗначениеЗаполнено(РеквизитыДоговора.РегистрационныйНомер),
		РеквизитыДоговора.РегистрационныйНомер, РеквизитыДоговора.ВременныйНомер);
	ДатаДоговора = ?(ЗначениеЗаполнено(РеквизитыДоговора.ДатаРегистрации),
		РеквизитыДоговора.ДатаРегистрации, РеквизитыДоговора.ДатаНачалаДействия);

	Объект.Тема = СтрШаблон("Договор № %1 от %2",
		НомерДоговора, Формат(ДатаДоговора, "ДЛФ=D"));

	// 3. Кому (Адресат): почтовые адреса контрагента из ТЧ «Стороны»
	Получатели.Очистить();
	Если Параметры.Свойство("УВМ_ПолучателиПисьма") Тогда
		МассивПочт = Параметры.УВМ_ПолучателиПисьма;
	Иначе
		МассивПочт = УВМ_ПочтыКонтрагентаПоДоговору(ДоговорКонтрагента);
	КонецЕсли;

	Для Каждого АдресПочты Из МассивПочт Цикл
		Если Не ЗначениеЗаполнено(АдресПочты) Тогда
			Продолжить;
		КонецЕсли;
		НовыйПолучатель = Получатели.Добавить();
		НовыйПолучатель.ТипАдреса      = Перечисления.ТипыАдресатов.Кому;
		НовыйПолучатель.Представление  = АдресПочты;
		НовыйПолучатель.Адрес          = АдресПочты;
		НовыйПолучатель.Внешний        = Истина;
		НовыйПолучатель.ВидМаршрутизации = Перечисления.ВидыМаршрутизацииПисем.Внешняя;
	КонецЦикла;

	// 4. Вложения: оставляем только PDF договора (он уже прикреплён к договору
	//    процедурой УВМ_ПрикрепитьФайлPDF до открытия формы и подтянут по основанию)
	МассивНаУдаление = Новый Массив;
	Для Каждого ТекВложение Из Вложения Цикл
		Если ВРег(Прав(ТекВложение.Представление, 4)) <> ".PDF" Тогда
			МассивНаУдаление.Добавить(ТекВложение);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ТекВложение Из МассивНаУдаление Цикл
		Вложения.Удалить(ТекВложение);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция УВМ_ПочтыКонтрагентаПоДоговору(ДоговорКонтрагента)

	Результат = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Договор", ДоговорКонтрагента);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Стороны.УВМ_Почта КАК УВМ_Почта
	|ИЗ
	|	Справочник.ДокументыПредприятия.Стороны КАК Стороны
	|ГДЕ
	|	Стороны.Ссылка = &Договор
	|	И Стороны.Сторона ССЫЛКА Справочник.Контрагенты";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Для Каждого АдресПочты Из СтрРазделить(СтрЗаменить(Выборка.УВМ_Почта, " ", ""), ",", Ложь) Цикл
			Если ЗначениеЗаполнено(АдресПочты) И Результат.Найти(АдресПочты) = Неопределено Тогда
				Результат.Добавить(АдресПочты);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

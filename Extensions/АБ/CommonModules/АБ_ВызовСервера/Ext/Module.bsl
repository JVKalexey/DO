//++dar 25.02.26 (309302)
Функция УВМ_ПолучитьИмяФайлаWord(Документ, КаталогВФ) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ДДФайла", "");
	Результат.Вставить("ПолноеИмяФайла", "");
	Результат.Вставить("НаименованиеФайла", "");
	//++dar 02.06.26 (330921)
	Результат.Вставить("PDFСуществует", Ложь);
	//--dar 02.06.26 (330921)
	
	МассивКомбинацийРолей = Новый Массив;
	РольДоговор = Новый Структура;
	РольДоговор.Вставить("Обязательная", Истина);
	РольДоговор.Вставить("Роль", УВМ_РольФайлаДоговор());
	МассивКомбинацийРолей.Добавить(РольДоговор);
	
	ТаблицаФайлы = Делопроизводство.ПолучитьДанныеФайловДляСписка(Неопределено, Документ, 
		Ложь, Ложь,
		МассивКомбинацийРолей);
		
	СтрокаДокумент = Неопределено;
	СтрокаDOC = ТаблицаФайлы.Найти("doc", "Расширение");
	Если СтрокаDOC <> Неопределено Тогда
		СтрокаДокумент = СтрокаDOC;
	Иначе	
		СтрокаDOCX = ТаблицаФайлы.Найти("docx", "Расширение");
		Если СтрокаDOCX <> Неопределено Тогда
			СтрокаДокумент = СтрокаDOCX;
		КонецЕсли;
	КонецЕсли;
	
	Если СтрокаДокумент <> Неопределено Тогда
		ПолноеИмяФайла = "";
		НаименованиеФайла = "";
	
		ДДФайла = РаботаСФайламиВызовСервера.ПолучитьДвоичныеДанныеФайла(СтрокаДокумент.Ссылка);
		ПолноеИмяФайла = СтрШаблон("%1%2.%3", КаталогВФ, СтрокаДокумент.Наименование, СтрокаДокумент.Расширение);
		НаименованиеФайла = СтрокаДокумент.Наименование;
	
		Результат.Вставить("ДДФайла", ДДФайла);
		Результат.Вставить("ПолноеИмяФайла", ПолноеИмяФайла);
		Результат.Вставить("НаименованиеФайла", НаименованиеФайла);
		
		//++dar 02.06.26 (330921)
		НайденныеPDF = ТаблицаФайлы.НайтиСтроки(Новый Структура("Расширение, Наименование", "pdf", НаименованиеФайла));
		Результат.PDFСуществует = (НайденныеPDF.Количество() > 0);
		//--dar 02.06.26 (330921)
		
	КонецЕсли;
	
	АдресФайла = ПоместитьВоВременноеХранилище(Результат);

	Возврат АдресФайла;
	
КонецФункции

Функция УВМ_РольФайлаДоговор() Экспорт

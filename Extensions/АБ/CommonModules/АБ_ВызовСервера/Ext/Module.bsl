// Получает значение из регистра сведений "Значения констант"
//
// Параметры:
//  <СтруктураОтбора>                      - <Структура>     - набор "ключей" для отбора, значение "Ключ" - обязательное 
//  <ЗначениеПоУмолчанию>                  - <Любое значение>- если результат работы функции Неопределено, функция вернет это значение
//
// Возвращаемое значение:
//   <Значение>      - значение ресурса по заданному ключу, если несколько (возвращается первый) 
//                    - если ключ не найден возвращается "Неопределено" или ЗначениеПоУмолчанию, если оно задано
// Пример вызова:
//		СтруктураОтбора = Новый Структура;
//		СтруктураОтбора.Вставить("Ключ",                    "Тест1");
//		 	
//			Не обязательные отборы:
//		СтруктураОтбора.Вставить("ГруппировочноеИзмерение", "ТестГр1");
//		СтруктураОтбора.Вставить("Организация",           Орг1);
//		СтруктураОтбора.Вставить("КлючДополнительный",        "КлючДоп1");
//
//		УВМ_ОбщиеДоработкиСервер.ЗначениеКонстантыИзРегистра(СтруктураОтбора)
//
&НаСервере
Функция ЗначениеКонстантыИзРегистра(СтруктураОтбора, ЗначениеПоУмолчанию = Неопределено) Экспорт
    
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|    УВМ_ЗначенияКонстант.Значение КАК Значение
	|ИЗ
	|    РегистрСведений.УВМ_ЗначенияКонстант КАК УВМ_ЗначенияКонстант
	|ГДЕ
	|    УВМ_ЗначенияКонстант.Ключ = &Ключ";
	
	ДопСтрока = "
	|    И УВМ_ЗначенияКонстант.Замена = &Замена";
	
	
	Для каждого ЭлементКоллекции Из СтруктураОтбора Цикл
		
		тКлюч = ЭлементКоллекции.Ключ;
		
		Запрос.УстановитьПараметр(тКлюч, ЭлементКоллекции.Значение);
		
		Если тКлюч <> "Ключ" Тогда 
			
			ТекстЗапроса = ТекстЗапроса + СтрЗаменить(ДопСтрока,"Замена",тКлюч);
			
		КонецЕсли;    
		
	КонецЦикла;
	
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = ЗначениеПоУмолчанию;
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Значение;
	КонецЕсли;
	
	Возврат Результат;
    
КонецФункции

Процедура УстановитьЗначениеКонстантыВРегистре(СтруктураИзмерений, ЗначениеКонстанты, Замещать=Истина) Экспорт
	
	Если не ЗначениеЗаполнено(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураИзмерений,"Ключ",Неопределено)) тогда
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.УВМ_ЗначенияКонстант.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Ключ 					= СтруктураИзмерений.Ключ;
	МенеджерЗаписи.ГруппировочноеИзмерение 	= ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураИзмерений,"ГруппировочноеИзмерение","");
	МенеджерЗаписи.Организация 				= ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураИзмерений,"Организация",Справочники.Организации.ПустаяСсылка());
	МенеджерЗаписи.КлючДополнительный 		= ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураИзмерений,"КлючДополнительный","");
	МенеджерЗаписи.Значение 				= ЗначениеКонстанты;	
	МенеджерЗаписи.Записать(Замещать);
		
КонецПроцедуры

#Область ВнешниеНавигационныеСсылкиДокументов
// +++ Миляев (295800) 2026-01-23
Функция ПолучитьТекстHTMLПоВнешнимНавигационнымСсылкам(пОбъект) Экспорт
	
	Результат = "";
	ВнешнийАдресБазы = АБ_ВызовСервера.ЗначениеКонстантыИзРегистра(Новый Структура("Ключ","АдресСервераВнешнийДоступ_ЕРПОсн"),Неопределено);
	Если ВнешнийАдресБазы = Неопределено тогда
		Возврат Результат;
	КонецЕсли;
	ДокументПредприятия = ДокументПредприятия(пОбъект);
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ДокументПредприятия",ДокументПредприятия);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АБ_ВнешниеНавигационныеСсылкиДокументов.Раздел КАК Раздел,
		|	АБ_ВнешниеНавигационныеСсылкиДокументов.НавигационнаяСсылка КАК НавигационнаяСсылка,
		|	АБ_ВнешниеНавигационныеСсылкиДокументов.ПредставлениеСсылки КАК ПредставлениеСсылки
		|ИЗ
		|	РегистрСведений.АБ_ВнешниеНавигационныеСсылкиДокументов КАК АБ_ВнешниеНавигационныеСсылкиДокументов
		|ГДЕ
		|	АБ_ВнешниеНавигационныеСсылкиДокументов.ДокументПредприятия = &ДокументПредприятия
		|ИТОГИ ПО
		|	Раздел";
	ВыборкаРазделов = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаРазделов.Следующий() цикл
		Результат = СтрШаблон("%1<br>%2<ul>",Результат,ВыборкаРазделов.Раздел);
		ВыборкаСсылок = ВыборкаРазделов.Выбрать();
		Пока ВыборкаСсылок.Следующий() цикл
			НавигационнаяСсылка = СтрШаблон("%1#%2",ВнешнийАдресБазы,ВыборкаСсылок.НавигационнаяСсылка);
			Результат = СтрШаблон("%1<li><a href=""%2"">%3</a></li>",Результат,НавигационнаяСсылка,ВыборкаСсылок.ПредставлениеСсылки);
		КонецЦикла;
		Результат = СтрШаблон("%1%2",Результат,"</ul>");
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция ДокументПредприятия(пОбъект) Экспорт
	Если ТипЗнч(пОбъект) = Тип("ДокументОбъект.Задача") тогда
		Возврат ДокументПредприятия(пОбъект.Источник);
	ИначеЕсли ТипЗнч(пОбъект) = Тип("ДокументСсылка.Задача") тогда
		Возврат ДокументПредприятия(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(пОбъект,"Источник"));
	ИначеЕсли ТипЗнч(пОбъект) = Тип("БизнесПроцессСсылка.Исполнение") тогда
		ТЧПредметы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(пОбъект,"Предметы");
		ТЧПредметы = ТЧПредметы.Выбрать();
		Пока ТЧПредметы.Следующий() цикл
			Если ЗначениеЗаполнено(ТЧПредметы.Предмет) И ТипЗнч(ТЧПредметы.Предмет)=Тип("СправочникСсылка.ДокументыПредприятия") тогда
				Возврат ТЧПредметы.Предмет;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(пОбъект) = Тип("БизнесПроцессОбъект.Исполнение") тогда
		ТЧпредметы = пОбъект.Предметы;
		Для Каждого лЗаписьТЧ из ТЧпредметы цикл
			Если ЗначениеЗаполнено(лЗаписьТЧ.Предмет) И ТипЗнч(лЗаписьТЧ.Предмет)=Тип("СправочникСсылка.ДокументыПредприятия") тогда
				Возврат лЗаписьТЧ.Предмет;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(пОбъект) = Тип("СправочникОбъект.ДокументыПредприятия") тогда
		Возврат пОбъект.Ссылка;
	ИначеЕсли ТипЗнч(пОбъект) = Тип("СправочникСсылка.ДокументыПредприятия") тогда
		Возврат пОбъект;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Процедура ЗагрузитьВнешниеСсылкиПоИННКонтрагентов(пИНН, пВидДокумента, пТипДоговора="СПокупателем", пРаздел="Действующие договоры") Экспорт
	
	СтруктураОтвет = ВыполнитьЗапросКоВнешнейБазеПоДействующимДоговорам(пИНН,пТипДоговора);
	Если СтруктураОтвет = Неопределено или ТипЗнч(СтруктураОтвет) <> Тип("Структура") тогда
		Возврат;
	КонецЕсли;
	ВнестиИнформациюОВнешнихСсылкахПоВнешнимДоговорам(СтруктураОтвет, пВидДокумента, пРаздел);
	
КонецПроцедуры 

Процедура ЗагрузитьВнешниеСсылкиДействующихДоговоровПоДокументам() Экспорт
	
	ВидДокументов = АБ_ВызовСервера.ЗначениеКонстантыИзРегистра(Новый Структура("Ключ","ВД_ДоговорПоставкиМыПоставщик"),Неопределено);
	Если не ЗначениеЗаполнено(ВидДокументов) тогда
		Возврат;
	КонецЕсли;  
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ВидДокумента",ВидДокументов);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДокументыПредприятия.Контрагент.ИНН КАК КонтрагентИНН
	|ИЗ
	|	Справочник.ДокументыПредприятия КАК ДокументыПредприятия
	|	    ЛЕВОЕ СОЕДИНЕНИЕ БизнесПроцесс.КомплексныйПроцесс.Предметы КАК КомплексныйПроцессПредметы
	|	    ПО (КомплексныйПроцессПредметы.Предмет = ДокументыПредприятия.Ссылка)
	|	    ЛЕВОЕ СОЕДИНЕНИЕ БизнесПроцесс.КомплексныйПроцесс КАК КомплексныйПроцесс
	|	    ПО (КомплексныйПроцессПредметы.Ссылка = КомплексныйПроцесс.Ссылка)
	|ГДЕ
	|	ДокументыПредприятия.ВидДокумента = &ВидДокумента
	|	И НЕ ЕСТЬNULL(КомплексныйПроцесс.Завершен,Ложь)";
	Выборка = Запрос.Выполнить().Выбрать();
	МассивИНН = Новый Массив();
	Пока Выборка.Следующий() цикл
		Если ЗначениеЗаполнено(Выборка.КонтрагентИНН) тогда
			МассивИНН.Добавить(Выборка.КонтрагентИНН);
		КонецЕсли;
	КонецЦикла;
	
	ЗагрузитьВнешниеСсылкиПоИННКонтрагентов(МассивИНН,ВидДокументов,"СПокупателем","Действующие договоры");
КонецПроцедуры

Функция ДанныеДляПодключенияHTTP_GetInfo_ERP_Основная() Экспорт
	//++dar 21.04.26 (доступ пользователям к РС.БезопасноеХранилищеДанных)
	УстановитьПривилегированныйРежим(Истина);
	//--dar 21.04.26 (доступ пользователям к РС.БезопасноеХранилищеДанных)
	Результат = Новый Структура();
	Результат.Вставить("СерверHTTP"        ,АБ_ВызовСервера.ЗначениеКонстантыИзРегистра(Новый Структура("Ключ","АдресСервераHTTP_ЕРПОсн"),"127.0.0.1"));
	Результат.Вставить("ИмяHTTPПубликации" ,АБ_ВызовСервера.ЗначениеКонстантыИзРегистра(Новый Структура("Ключ","ИмяБазыHTTP_ЕРПОсн"),""));
	Результат.Вставить("ЛогинПользователя" ,АБ_ВызовСервера.ЗначениеКонстантыИзРегистра(Новый Структура("Ключ","ЛогинHTTP_ЕРПОсн"),""));
	Результат.Вставить("ПарольПользователя",ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(СтрШаблон("Пароль_%1",Результат.ЛогинПользователя)));
	Возврат Результат;
КонецФункции

Функция МассивДействующихДоговоровИзВнешнейБазы(пИНН,пТипДоговора="СПокупателем") Экспорт

	Возврат ВыполнитьЗапросКоВнешнейБазеПоДействующимДоговорам(пИНН,пТипДоговора);
	
КонецФункции

Функция ВыполнитьЗапросКоВнешнейБазеПоДействующимДоговорам(пИНН,пТипДоговора) Экспорт
	Если ТипЗнч(пИНН) = Тип("Строка") И ЗначениеЗаполнено(пИНН) тогда
		МассивИНН = Новый Массив();
		МассивИНН.Добавить(пИНН);
	ИначеЕсли ТипЗнч(пИНН) = Тип("Массив") И пИНН.Количество()>0 тогда
		МассивИНН = пИНН;
	Иначе	
		Возврат Неопределено;
	КонецЕсли;
	
	ДанныеДляПодключенияGetInfo = ДанныеДляПодключенияHTTP_GetInfo_ERP_Основная();
	СтруктураДляЗапроса = Новый Структура("ИНН,ТипДоговора",МассивИНН,пТипДоговора);
	
	//++dar 24.04.26 (с помощью АБ_КоннекторHTTP)
	//СоединениеHTTP = Новый HTTPСоединение(ДанныеДляПодключенияGetInfo.СерверHTTP,,ДанныеДляПодключенияGetInfo.ЛогинПользователя,ДанныеДляПодключенияGetInfo.ПарольПользователя);
	//ЗапросHTTP = Новый HTTPЗапрос(СтрШаблон("%1/hs/getinfo/v1/getcurrentcontractsbyinn",ДанныеДляПодключенияGetInfo.ИмяHTTPПубликации));
	//ЗапросHTTP.УстановитьТелоИзСтроки(СериализацияJson(СтруктураДляЗапроса),КодировкаТекста.UTF8);
	//Ответ = СоединениеHTTP.Получить(ЗапросHTTP);
	//Если Ответ.КодСостояния<>200 тогда
	//	Возврат Неопределено;
	//КонецЕсли;
	//Возврат ДесериализацияJson(Ответ.ПолучитьТелоКакСтроку());
	
	URL = СтрШаблон("http://%1/%2/hs/getinfo/v1/getcurrentcontractsbyinn", ДанныеДляПодключенияGetInfo.СерверHTTP, ДанныеДляПодключенияGetInfo.ИмяHTTPПубликации);
	
	ПараметрыЗапроса = АБ_КоннекторHTTP.НовыеПараметры();
	ПараметрыЗапроса.Аутентификация = АБ_КоннекторHTTP.НоваяАутентификацияBasic(ДанныеДляПодключенияGetInfo.ЛогинПользователя, ДанныеДляПодключенияGetInfo.ПарольПользователя);
	ПараметрыЗапроса.ПроверятьSSL = Ложь;
	ПараметрыЗапроса.Json = СтруктураДляЗапроса;
	
	ОтветHTTP = АБ_КоннекторHTTP.Post(URL, Неопределено, ПараметрыЗапроса);
	
	Если ОтветHTTP.КодСостояния <> 200 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат АБ_КоннекторHTTP.КакJson(ОтветHTTP, Новый Структура("ПрочитатьВСоответствие", Ложь));
	//--dar 24.04.26 (с помощью АБ_КоннекторHTTP)

КонецФункции

Процедура ВнестиИнформациюОВнешнихСсылкахПоВнешнимДоговорам(пСтруктураОтвет,пВидДокумента, пРаздел="Действующие договоры") Экспорт
	ВнешниеСсылки = Неопределено;
	пСтруктураОтвет.Свойство("ДоговорыНавСсылки",ВнешниеСсылки); 
	Если ВнешниеСсылки = неопределено тогда
		Возврат;
	КонецЕсли;  
	Если не ЗначениеЗаполнено(пВидДокумента) тогда
    	Возврат;
	КонецЕсли;
	
	ТаблицаДляЗапроса = Новый ТаблицаЗначений();
	ТаблицаДляЗапроса.Колонки.Добавить("ИНН",ОбщегоНазначения.ОписаниеТипаСтрока(20));
	ТаблицаДляЗапроса.Колонки.Добавить("Раздел",ОбщегоНазначения.ОписаниеТипаСтрока(100));
	ТаблицаДляЗапроса.Колонки.Добавить("НавигационнаяСсылка",ОбщегоНазначения.ОписаниеТипаСтрока(250));
	ТаблицаДляЗапроса.Колонки.Добавить("ПредставлениеСсылки",ОбщегоНазначения.ОписаниеТипаСтрока(250));
	Для Каждого ЭлементВнешСсылки из ВнешниеСсылки цикл
		НовЗаписьТЗ = ТаблицаДляЗапроса.Добавить();
		ЗаполнитьЗначенияСвойств(НовЗаписьТЗ,ЭлементВнешСсылки);
		НовЗаписьТЗ.Раздел = пРаздел;
	КонецЦикла;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ТаблицаВнешнихСсылок",ТаблицаДляЗапроса);
	Запрос.УстановитьПараметр("ВидДокумента",пВидДокумента);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаВнешнихСсылок.ИНН КАК ИНН,
	|	ТаблицаВнешнихСсылок.Раздел КАК Раздел,
	|	ТаблицаВнешнихСсылок.НавигационнаяСсылка КАК НавигационнаяСсылка,
	|	ТаблицаВнешнихСсылок.ПредставлениеСсылки КАК ПредставлениеСсылки
	|ПОМЕСТИТЬ ТаблицаВнешнихСсылокВрем
	|ИЗ
	|	&ТаблицаВнешнихСсылок КАК ТаблицаВнешнихСсылок
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИНН
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДокументыПредприятия.Ссылка КАК ДокументПредприятия,
	|	ДокументыПредприятия.Контрагент.ИНН КАК КонтрагентИНН
	|ПОМЕСТИТЬ НезавершенныеДокументы
	|ИЗ
	|	Справочник.ДокументыПредприятия КАК ДокументыПредприятия
	|		ЛЕВОЕ СОЕДИНЕНИЕ БизнесПроцесс.КомплексныйПроцесс.Предметы КАК КомплексныйПроцессПредметы
	|		ПО (КомплексныйПроцессПредметы.Предмет = ДокументыПредприятия.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ БизнесПроцесс.КомплексныйПроцесс КАК КомплексныйПроцесс
	|		ПО (КомплексныйПроцессПредметы.Ссылка = КомплексныйПроцесс.Ссылка)
	|ГДЕ
	|	ДокументыПредприятия.ВидДокумента = &ВидДокумента
	|	И НЕ ЕСТЬNULL(КомплексныйПроцесс.Завершен, ЛОЖЬ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаВнешнихСсылокВрем.Раздел КАК Раздел,
	|	ТаблицаВнешнихСсылокВрем.НавигационнаяСсылка КАК НавигационнаяСсылка,
	|	ТаблицаВнешнихСсылокВрем.ПредставлениеСсылки КАК ПредставлениеСсылки,
	|	НезавершенныеДокументы.ДокументПредприятия КАК ДокументПредприятия
	|ПОМЕСТИТЬ ДанныеДляРегистраВнешнихСсылок
	|ИЗ
	|	ТаблицаВнешнихСсылокВрем КАК ТаблицаВнешнихСсылокВрем
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НезавершенныеДокументы КАК НезавершенныеДокументы
	|		ПО ТаблицаВнешнихСсылокВрем.ИНН = НезавершенныеДокументы.КонтрагентИНН
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеДляРегистраВнешнихСсылок.ДокументПредприятия КАК ДокументПредприятия,
	|	ДанныеДляРегистраВнешнихСсылок.Раздел КАК Раздел,
	|	ДанныеДляРегистраВнешнихСсылок.НавигационнаяСсылка КАК НавигационнаяСсылка,
	|	ДанныеДляРегистраВнешнихСсылок.ПредставлениеСсылки КАК ПредставлениеСсылки
	|ИЗ
	|	ДанныеДляРегистраВнешнихСсылок КАК ДанныеДляРегистраВнешнихСсылок
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АБ_ВнешниеНавигационныеСсылкиДокументов КАК АБ_ВнешниеНавигационныеСсылкиДокументов
	|		ПО ДанныеДляРегистраВнешнихСсылок.ДокументПредприятия = АБ_ВнешниеНавигационныеСсылкиДокументов.ДокументПредприятия
	|			И ДанныеДляРегистраВнешнихСсылок.ПредставлениеСсылки = АБ_ВнешниеНавигационныеСсылкиДокументов.ПредставлениеСсылки
	|			И ДанныеДляРегистраВнешнихСсылок.Раздел = АБ_ВнешниеНавигационныеСсылкиДокументов.Раздел
	|			И ДанныеДляРегистраВнешнихСсылок.НавигационнаяСсылка = АБ_ВнешниеНавигационныеСсылкиДокументов.НавигационнаяСсылка
	|ГДЕ
	|	АБ_ВнешниеНавигационныеСсылкиДокументов.ДокументПредприятия ЕСТЬ NULL
	|ИТОГИ ПО
	|	ДокументПредприятия,
	|	Раздел";
	
	ВыборкаДокумент = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДокумент.Следующий() цикл
		ВыборкаРаздел = ВыборкаДокумент.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаРаздел.Следующий() цикл
			НаборЗаписейРСВ = РегистрыСведений.АБ_ВнешниеНавигационныеСсылкиДокументов.СоздатьНаборЗаписей();
			НаборЗаписейРСВ.Отбор.ДокументПредприятия.Установить(ВыборкаДокумент.ДокументПредприятия);
			НаборЗаписейРСВ.Отбор.Раздел.Установить(ВыборкаРаздел.Раздел);
			НаборЗаписейРСВ.Прочитать();
			НаборЗаписейРСВ.Очистить();
			
			СчетчикСтрок = 1;
			ВыборкаДет = ВыборкаРаздел.Выбрать();
			Пока ВыборкаДет.Следующий() цикл
				ЗаписьНЗ = НаборЗаписейРСВ.Добавить();
				ЗаписьНЗ.НавигационнаяСсылка = ВыборкаДет.НавигационнаяСсылка;
				ЗаписьНЗ.ПредставлениеСсылки = ВыборкаДет.ПредставлениеСсылки;
				ЗаписьНЗ.ДопКлюч             = Формат(СчетчикСтрок,"ЧЦ=5; ЧВН=; ЧГ=");
				ЗаписьНЗ.Раздел              = ВыборкаРаздел.Раздел;
				ЗаписьНЗ.ДокументПредприятия = ВыборкаДокумент.ДокументПредприятия;
				СчетчикСтрок = СчетчикСтрок + 1;
			КонецЦикла;
		КонецЦикла;
		
		НаборЗаписейРСВ.Записать();
	КонецЦикла;
КонецПроцедуры

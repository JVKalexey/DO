Процедура СоздатьДоговорВоВнешнейБазе(Документ) Экспорт
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, "Наименование, ВидДокумента, УВМ_КоличествоДнейОтсрочки, 
																			 |УВМ_ПроцентНеустойки, УВМ_ТипНеустойки, Ответственный.Наименование,
																			 |УВМ_ВидАгентскогоДоговора, УВМ_НалогообложениеНДС, УВМ_НалогообложениеНДСОпределяетсяВДокументе,
																			 //++GIV 24032026 (320030)
																			 |УВМ_СтавкаНДС.Наименование, СуммаНДС, РегистрационныйНомер, ДатаСоздания"); 
																			 //--GIV 24032026 (320030)
	
	СтруктураДляЗапроса = Новый Структура;
	СтруктураДляЗапроса.Вставить("ВидДокументаДОID", XMLСтрока(РеквизитыДоговора.ВидДокумента.УникальныйИдентификатор()));//гуид вида договора из ДО
	СтруктураДляЗапроса.Вставить("ОсновнойПредметID", XMLСтрока(Документ.УникальныйИдентификатор()));//гуид договора из ДО(справочник документы предприятия)
	СтруктураДляЗапроса.Вставить("ОсновнойПредметТип", "DMDocument");
	СтруктураДляЗапроса.Вставить("УВМ_КоличествоДнейОтсрочки", РеквизитыДоговора.УВМ_КоличествоДнейОтсрочки);
	СтруктураДляЗапроса.Вставить("УВМ_ПроцентНеустойки", РеквизитыДоговора.УВМ_ПроцентНеустойки);
	//++GIV 24032026 (320030)
	СтруктураДляЗапроса.Вставить("Дата", РеквизитыДоговора.ДатаСоздания);
	СтруктураДляЗапроса.Вставить("Номер", РеквизитыДоговора.РегистрационныйНомер);
	//--GIV 24032026 (320030)
	
	СтруктураДляЗапроса.Вставить("УВМ_ТипНеустойки", Неопределено);
	Если ЗначениеЗаполнено(РеквизитыДоговора.УВМ_ТипНеустойки) Тогда
		СтруктураДляЗапроса.Вставить("УВМ_ТипНеустойки", ОбщегоНазначения.ИмяЗначенияПеречисления(РеквизитыДоговора.УВМ_ТипНеустойки)); 
	КонецЕсли;
	
	СтруктураДляЗапроса.Вставить("Менеджер", РеквизитыДоговора.ОтветственныйНаименование);
	СтруктураДляЗапроса.Вставить("НаименованиеДоговора", РеквизитыДоговора.Наименование);
	
	//для раздела Налогообложение
	СтруктураДляЗапроса.Вставить("ВидАгентскогоДоговора", Неопределено);
	Если ЗначениеЗаполнено(РеквизитыДоговора.УВМ_ВидАгентскогоДоговора) Тогда
		СтруктураДляЗапроса.Вставить("ВидАгентскогоДоговора", ОбщегоНазначения.ИмяЗначенияПеречисления(РеквизитыДоговора.УВМ_ВидАгентскогоДоговора));
	КонецЕсли;
	
	СтруктураДляЗапроса.Вставить("НалогообложениеНДС", Неопределено);
	Если ЗначениеЗаполнено(РеквизитыДоговора.УВМ_НалогообложениеНДС) Тогда
		СтруктураДляЗапроса.Вставить("НалогообложениеНДС", ОбщегоНазначения.ИмяЗначенияПеречисления(РеквизитыДоговора.УВМ_НалогообложениеНДС));
	КонецЕсли;
	
	СтруктураДляЗапроса.Вставить("НалогообложениеНДСОпределяетсяВДокументе", РеквизитыДоговора.УВМ_НалогообложениеНДСОпределяетсяВДокументе);
	Если ЗначениеЗаполнено(РеквизитыДоговора.УВМ_СтавкаНДСНаименование) Тогда
		СтруктураДляЗапроса.Вставить("СтавкаНДС", РеквизитыДоговора.УВМ_СтавкаНДСНаименование);
	Иначе
		СтруктураДляЗапроса.Вставить("СтавкаНДС", "22%");
	КонецЕсли;
	СтруктураДляЗапроса.Вставить("УВМ_СуммаНДС", РеквизитыДоговора.СуммаНДС);
	
	ДанныеДляПодключенияGetInfo = ДанныеДляПодключенияHTTP_GetInfo_ERP_Основная();
	
	СоединениеHTTP = Новый HTTPСоединение(ДанныеДляПодключенияGetInfo.СерверHTTP,,ДанныеДляПодключенияGetInfo.ЛогинПользователя,ДанныеДляПодключенияGetInfo.ПарольПользователя);
	ЗапросHTTP = Новый HTTPЗапрос(СтрШаблон("%1/hs/getinfo/v1/create_contract",ДанныеДляПодключенияGetInfo.ИмяHTTPПубликации));
	ЗапросHTTP.УстановитьТелоИзСтроки(АБ_ВызовСервера.СериализацияJson(СтруктураДляЗапроса),КодировкаТекста.UTF8);
	Ответ = СоединениеHTTP.ВызватьHTTPМетод("POST", ЗапросHTTP);
	Если Ответ.КодСостояния<>200 тогда
		//++GIV 25032026 (320030) Если не 200 то откуда json
		//ТекстОтвета = АБ_ВызовСервера.ДесериализацияJson(Ответ.ПолучитьТелоКакСтроку());
		ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();  
		//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Ошибка при передаче договора в ERP %1", ТекстОтвета));
		ЗаписьЖурналаРегистрации("УВМ_ОшибкаСозданияДоговораВЕРП", УровеньЖурналаРегистрации.Ошибка, , , СтрШаблон("Возникла ошибка при создании договора в ЕРП %1", ТекстОтвета));
		Если ОбщегоНазначения.РежимОтладки() Тогда
			ВызватьИсключение(СтрШаблон("Ошибка при передаче договора в ERP %1", ТекстОтвета),КатегорияОшибки.ОшибкаСети,Ответ.КодСостояния);
		КонецЕсли;
		//--GIV 25032026 (320030)
	КонецЕсли;

КонецПроцедуры

#Область ИсторияИзменений

//++dar 01.06.26 (330575)
// Включает историю данных для объекта метаданных и его реквизита. Идемпотентно;
// настройки истории данных меняет только администратор.
Функция ОбеспечитьВедениеИсторииРеквизита(ОбъектМетаданных, ИмяРеквизита) Экспорт
	
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РеквизитМетаданных = ОбъектМетаданных.Реквизиты.Найти(ИмяРеквизита);
	Если РеквизитМетаданных = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не Пользователи.ЭтоПолноправныйПользователь(, Истина) Тогда
		Возврат ИспользуетсяИсторияДанных(ОбъектМетаданных);
	КонецЕсли;
	
	Попытка
		Настройки = ИсторияДанных.ПолучитьНастройки(ОбъектМетаданных);
		
		ИсторияВключена = (Настройки <> Неопределено И Настройки.Использование);
		РеквизитВключен = ИсторияВключена И НастройкаРеквизитаВключена(Настройки, РеквизитМетаданных.Имя);
		
		Если ИсторияВключена И РеквизитВключен Тогда
			Возврат Истина;
		КонецЕсли;
		
		Если Настройки = Неопределено Тогда
			Настройки = Новый НастройкиИсторииДанных;
		КонецЕсли;
		
		Настройки.Использование = Истина;
		Настройки.ИспользованиеПолей.Вставить(РеквизитМетаданных, Истина);
		
		ИсторияДанных.УстановитьНастройки(ОбъектМетаданных, Настройки);
		
	Исключение
		ЗаписьЖурналаРегистрации(
		НСтр("ru = 'История данных'"),
		УровеньЖурналаРегистрации.Ошибка,
		ОбъектМетаданных,
		,
		ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

// Проверяет, включено ли ведение истории данных для объекта метаданных.
Функция ИспользуетсяИсторияДанных(ОбъектМетаданных) Экспорт
	
	Попытка
		Настройки = ИсторияДанных.ПолучитьНастройки(ОбъектМетаданных);
		Возврат Настройки <> Неопределено И Настройки.Использование;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

// Возвращает ВСЮ историю изменения реквизита (по убыванию даты).
// Массив структур: НомерВерсии, ДатаИзменения, Автор, Значение.
Функция ИсторияИзмененийРеквизита(Ссылка, ИмяРеквизита) Экспорт
	
	Результат = Новый Массив;
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТаблицаВерсий = ВыбратьВерсииРеквизита(Ссылка, ИмяРеквизита);
	Если ТаблицаВерсий = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого Версия Из ТаблицаВерсий Цикл
		
		Элемент = Новый Структура;
		Элемент.Вставить("НомерВерсии",   "");
		Элемент.Вставить("ДатаИзменения", '00010101000000');
		Элемент.Вставить("Автор",         "");
		Элемент.Вставить("Значение",      "");
		
		Попытка
			Элемент.НомерВерсии = Версия.НомерВерсии;
		Исключение
		КонецПопытки;
		Попытка
			Элемент.ДатаИзменения = Версия.Дата;
		Исключение
		КонецПопытки;
		Попытка
			Элемент.Автор = ПредставлениеАвтораВерсии(Версия.Пользователь);
		Исключение
		КонецПопытки;
		
		Элемент.Значение = ЗначениеРеквизитаИзДанныхВерсии(Ссылка, Элемент.НомерВерсии, ИмяРеквизита);
		
		Результат.Добавить(Элемент);
		
	КонецЦикла;
	
	СортироватьИсториюПоУбываниюДаты(Результат);
	
	Возврат Результат;
	
КонецФункции

// HTML-представление всей истории изменения реквизита для поля "Поле HTML документа".
Функция ПредставлениеИсторииРеквизитаHTML(Ссылка, ИмяРеквизита, ЗаголовокРаздела = "") Экспорт
	
	История = ИсторияИзмененийРеквизита(Ссылка, ИмяРеквизита);
	Если История.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Заголовок = ЗаголовокРаздела;
	Если Не ЗначениеЗаполнено(Заголовок) Тогда
		Заголовок = СтрШаблон(НСтр("ru = 'История изменения: %1'"), ИмяРеквизита);
	КонецЕсли;
	
	СтрокиТаблицы = "";
	Для Каждого Изменение Из История Цикл
		ДатаПредставление = ?(ЗначениеЗаполнено(Изменение.ДатаИзменения),
		Формат(Изменение.ДатаИзменения, "ДЛФ=DT"), "");
		СтрокиТаблицы = СтрокиТаблицы
		+ "<tr>"
		+ "<td style=""white-space:nowrap;vertical-align:top;padding:2px 8px;border-bottom:1px solid #e0e0e0;"">" + ЭкранироватьHTML(ДатаПредставление) + "</td>"
		+ "<td style=""vertical-align:top;padding:2px 8px;border-bottom:1px solid #e0e0e0;"">" + ЭкранироватьHTML(Изменение.Автор) + "</td>"
		+ "<td style=""vertical-align:top;padding:2px 8px;border-bottom:1px solid #e0e0e0;"">" + ЭкранироватьHTML(Изменение.Значение) + "</td>"
		+ "</tr>";
	КонецЦикла;
	
	HTML = ЗаголовокРаздела + "<br><table style=""border-collapse:collapse;width:100%;"">"
	+ "<tr style=""text-align:left;"">"
	+ "<th style=""padding:2px 8px;border-bottom:2px solid #c0c0c0;"">" + НСтр("ru = 'Дата изменения'") + "</th>"
	+ "<th style=""padding:2px 8px;border-bottom:2px solid #c0c0c0;"">" + НСтр("ru = 'Автор'") + "</th>"
	+ "<th style=""padding:2px 8px;border-bottom:2px solid #c0c0c0;"">" + НСтр("ru = 'Значение'") + "</th>"
	+ "</tr>"
	+ СтрокиТаблицы
	+ "</table>";
	
	Возврат HTML;
	
КонецФункции
//--dar 01.06.26 (330575)

// Возвращает таблицу версий истории данных, в которых менялся указанный реквизит,
// либо все версии объекта, если отбор по изменению полей не поддерживается.
//
Функция ВыбратьВерсииРеквизита(Ссылка, ИмяРеквизита)
	
	ОбъектМетаданных = Ссылка.Метаданные();
	ТаблицаВерсий = Неопределено;
	
	// Сначала пытаемся отобрать только версии, в которых менялся реквизит.
	Попытка
		Отбор = Новый Структура;
		Отбор.Вставить("Метаданные", ОбъектМетаданных);
		Отбор.Вставить("Данные", Ссылка);
		Отбор.Вставить("ИзменениеЗначенийПолей", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ИмяРеквизита));
		ТаблицаВерсий = ИсторияДанных.ВыбратьВерсии(Отбор);
	Исключение
		ТаблицаВерсий = Неопределено;
	КонецПопытки;
	
	// Если отбор по изменению значений полей не поддерживается - все версии объекта.
	Если ТаблицаВерсий = Неопределено Тогда
		Попытка
			Отбор = Новый Структура;
			Отбор.Вставить("Метаданные", ОбъектМетаданных);
			Отбор.Вставить("Данные", Ссылка);
			ТаблицаВерсий = ИсторияДанных.ВыбратьВерсии(Отбор);
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Если ТаблицаВерсий = Неопределено Или ТаблицаВерсий.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ТаблицаВерсий;
	
КонецФункции

// Читает значение реквизита из данных конкретной версии истории данных.
//
Функция ЗначениеРеквизитаИзДанныхВерсии(Ссылка, НомерВерсии, ИмяРеквизита)
	
	Если Не ЗначениеЗаполнено(НомерВерсии) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		ДанныеВерсии = ИсторияДанных.ПолучитьДанныеВерсии(Ссылка, НомерВерсии);
		Если ДанныеВерсии = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		
		Если ТипЗнч(ДанныеВерсии) = Тип("Структура") Тогда
			Значение = "";
			ДанныеВерсии.Свойство(ИмяРеквизита, Значение);
			Возврат Строка(Значение);
		Иначе
			Возврат Строка(ДанныеВерсии[ИмяРеквизита]);
		КонецЕсли;
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

// Возвращает представление пользователя ИБ по идентификатору из истории данных.
//
Функция ПредставлениеАвтораВерсии(ИдентификаторПользователя)
	
	Если Не ЗначениеЗаполнено(ИдентификаторПользователя) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		ИдентификаторИБ = ИдентификаторПользователя;
		Если ТипЗнч(ИдентификаторИБ) = Тип("Строка") Тогда
			ИдентификаторИБ = Новый УникальныйИдентификатор(ИдентификаторИБ);
		КонецЕсли;
		
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(ИдентификаторИБ);
		Если ПользовательИБ <> Неопределено Тогда
			Возврат ?(ЗначениеЗаполнено(ПользовательИБ.ПолноеИмя), ПользовательИБ.ПолноеИмя, ПользовательИБ.Имя);
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат Строка(ИдентификаторПользователя);
	
КонецФункции

// Возвращает Истина, если в настройках истории данных включён указанный реквизит.
//
Функция НастройкаРеквизитаВключена(Настройки, ИмяРеквизита)
	
	Если Настройки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗначениеНастройки = Настройки.ИспользованиеПолей.Получить(ИмяРеквизита);
	ЗначениеНастройки = ?(ЗначениеНастройки = Неопределено, Ложь, ЗначениеНастройки);
	
	Возврат ЗначениеНастройки;
	
КонецФункции

// Сортирует массив структур истории по убыванию даты изменения.
//
Процедура СортироватьИсториюПоУбываниюДаты(История)
	
	Количество = История.Количество();
	Для НомерI = 1 По Количество - 1 Цикл
		Для НомерJ = 0 По Количество - 1 - НомерI Цикл
			Если История[НомерJ].ДатаИзменения < История[НомерJ + 1].ДатаИзменения Тогда
				Временный = История[НомерJ];
				История[НомерJ] = История[НомерJ + 1];
				История[НомерJ + 1] = Временный;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Экранирует спецсимволы HTML и переводит переносы строк в <br>.
//
Функция ЭкранироватьHTML(Текст)
	
	Результат = Строка(Текст);
	Результат = СтрЗаменить(Результат, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Результат = СтрЗаменить(Результат, Символы.ВК, "");
	Результат = СтрЗаменить(Результат, Символы.ПС, "<br>");
	Возврат Результат;
	
КонецФункции

#КонецОбласти

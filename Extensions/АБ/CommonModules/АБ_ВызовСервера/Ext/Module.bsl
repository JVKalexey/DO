	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДокументыПредприятия.УВМ_ВариантДоговора КАК УВМ_ВариантДоговора,
	|	ДокументыПредприятия.УВМ_ПлощадьНежилогоПомещения КАК УВМ_ПлощадьНежилогоПомещения,
	|	ДокументыПредприятия.УВМ_ПлощадьЗдания КАК УВМ_ПлощадьЗдания,
	|	ДокументыПредприятия.УВМ_ЭтажЗдания КАК УВМ_ЭтажЗдания,
	|	ДокументыПредприятия.УВМ_КадастровыйНомерЗдания КАК УВМ_КадастровыйНомерЗдания,
	|	ДокументыПредприятия.УВМ_КадастровыйНомерУчастка КАК УВМ_КадастровыйНомерУчастка,
	|	ДокументыПредприятия.УВМ_АдресОбъекта КАК УВМ_АдресОбъекта,
	|	ДокументыПредприятия.УВМ_ПередаваемоеОборудование КАК УВМ_ПередаваемоеОборудование,
	|	ДокументыПредприятия.УВМ_ОснованиеПраваСобственности КАК УВМ_ОснованиеПраваСобственности,
	|	ДокументыПредприятия.УВМ_СрокПередачиОбъектаАрендодателем КАК УВМ_СрокПередачиОбъектаАрендодателем,
	|	ДокументыПредприятия.УВМ_СрокПринятияОбъектаАрендатором КАК УВМ_СрокПринятияОбъектаАрендатором,
	|	ДокументыПредприятия.УВМ_ЕжемесячнаяПостояннаяЧастьАренднойПлаты КАК УВМ_ЕжемесячнаяПостояннаяЧастьАренднойПлаты,
	|	ДокументыПредприятия.УВМ_НДСВСоставеАренднойПлаты КАК УВМ_НДСВСоставеАренднойПлаты,
	|	ДокументыПредприятия.УВМ_АренднаяПлатаЗаПользованиеОборудованием КАК УВМ_АренднаяПлатаЗаПользованиеОборудованием,
	|	ДокументыПредприятия.УВМ_ОснащениеИмущества КАК УВМ_ОснащениеИмущества,
	|	ДокументыПредприятия.УВМ_ДополнительноПереданныеДокументыИПредметы КАК УВМ_ДополнительноПереданныеДокументыИПредметы,
	|	ДокументыПредприятия.УВМ_ПоказанияПриборовУчётаНаМоментПередачи КАК УВМ_ПоказанияПриборовУчётаНаМоментПередачи
	|ИЗ
	|	Справочник.ДокументыПредприятия КАК ДокументыПредприятия
	|ГДЕ
	|	ДокументыПредприятия.Ссылка = &Документ
	|	И (ДокументыПредприятия.УВМ_ВариантДоговора = ЗНАЧЕНИЕ(Перечисление.УВМ_ВариантыДоговоров.ДоговорАрендыОфиса)
	|			ИЛИ ДокументыПредприятия.УВМ_ВариантДоговора = ЗНАЧЕНИЕ(Перечисление.УВМ_ВариантыДоговоров.ДоговорАрендыСкладскихПомещений))";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДоговорАрендыОфиса = (Выборка.УВМ_ВариантДоговора = Перечисления.УВМ_ВариантыДоговоров.ДоговорАрендыОфиса); 
		ДоговорАрендыСкладскогоПомещения = (Выборка.УВМ_ВариантДоговора = Перечисления.УВМ_ВариантыДоговоров.ДоговорАрендыСкладскихПомещений);
		
		Результат = СтрШаблон("Реквизиты аренды %1", "<br>");
		Результат = СтрШаблон("%1<br>%2: %3", Результат, "Площадь нежилого помещения/части нежилого помещения (кв. м.)", Выборка.УВМ_ПлощадьНежилогоПомещения);
		Результат = СтрШаблон("%1<br>%2: %3", Результат, "Площадь здания (кв. м.)", Выборка.УВМ_ПлощадьЗдания);
		Если ДоговорАрендыОфиса Тогда
			Результат = СтрШаблон("%1<br>%2: %3", Результат, "Этаж здания", Выборка.УВМ_ЭтажЗдания);
		КонецЕсли;
		Результат = СтрШаблон("%1<br>%2: %3", Результат, "Кадастровый номер здания", Выборка.УВМ_КадастровыйНомерЗдания);
		Если ДоговорАрендыСкладскогоПомещения Тогда
			Результат = СтрШаблон("%1<br>%2: %3", Результат, "Кадастровый номер участка", Выборка.УВМ_КадастровыйНомерУчастка);
		КонецЕсли;
		Результат = СтрШаблон("%1<br>%2: %3", Результат, "Адрес объекта", Выборка.УВМ_АдресОбъекта);
		Если ДоговорАрендыСкладскогоПомещения Тогда
			Результат = СтрШаблон("%1<br>%2: %3", Результат, "Вместе с Объектом в аренду Арендатору передается следующее оборудование", Выборка.УВМ_ПередаваемоеОборудование);
		КонецЕсли;
		Результат = СтрШаблон("%1<br>%2: %3", Результат, "Объект принадлежит Арендодателю на праве собственности (аренды) на основании следующих документов", Выборка.УВМ_ОснованиеПраваСобственности);
		Результат = СтрШаблон("%1<br>%2: %3", Результат, "Арендодатель обязан передать Объект аренды по акту приема-передачи в срок до", Формат(Выборка.УВМ_СрокПередачиОбъектаАрендодателем, "ДФ=dd.MM.yyyy"));
		Результат = СтрШаблон("%1<br>%2: %3", Результат, "Арендатор обязан принять Объект от Арендодателя по акту приема-передачи до", Формат(Выборка.УВМ_СрокПринятияОбъектаАрендатором, "ДФ=dd.MM.yyyy"));
		Результат = СтрШаблон("%1<br>%2: %3", Результат, "Ежемесячная постоянная часть арендной платы составляет (рублей в месяц)", Выборка.УВМ_ЕжемесячнаяПостояннаяЧастьАренднойПлаты);
		Результат = СтрШаблон("%1<br>%2: %3", Результат, "В т.ч. НДС", Выборка.УВМ_НДСВСоставеАренднойПлаты);
		Если ДоговорАрендыСкладскогоПомещения Тогда
			Результат = СтрШаблон("%1<br>%2: %3", Результат, "Арендная плата за пользование оборудованием составляет", Выборка.УВМ_АренднаяПлатаЗаПользованиеОборудованием);
		КонецЕсли;
		Результат = СтрШаблон("%1<br>%2: %3", Результат, "Имущество оснащено (данные, указанные через запятую, будут отображены с новой строки)", Выборка.УВМ_ОснащениеИмущества);
		Результат = СтрШаблон("%1<br>%2: %3", Результат, "Вместе с передачей Имущества представителю Арендатора переданы", Выборка.УВМ_ДополнительноПереданныеДокументыИПредметы);
		Результат = СтрШаблон("%1<br>%2: %3", Результат, "Показания приборов учета на момент передачи Имущества (данные, указанные через запятую, будут отображены с новой строки)", Выборка.УВМ_ПоказанияПриборовУчётаНаМоментПередачи);
		Результат = СтрШаблон("%1<br>", Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

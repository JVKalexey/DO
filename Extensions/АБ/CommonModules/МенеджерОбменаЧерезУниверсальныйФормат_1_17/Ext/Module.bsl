Процедура ПОД_РегистрСведений_УВМ_ИсторияРегистрацийВНалоговомОргане_Получение_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	
	СвойстваОтбор = ДанныеXDTO;
	Если ДанныеXDTO.Свойство("КлючевыеСвойства") Тогда
		СвойстваОтбор = ДанныеXDTO.КлючевыеСвойства;
	КонецЕсли;
	Если ДанныеXDTO.Свойство("Записи") Тогда
		Записи = ДанныеXDTO.Записи;
	Иначе
		Записи = Новый ТаблицаЗначений;
	КонецЕсли;
	
	тПериод         = Дата(1,1,1);
	тОрганизация   	= Справочники.Организации.ПустаяСсылка();
	ПериодОтбор         = Неопределено; 
	ОрганизацияОтбор   	= Неопределено;
	
	СвойстваОтбор.Свойство("ПериодОтбор",       	ПериодОтбор);
	СвойстваОтбор.Свойство("СтруктурнаяЕдиницаОтбор",  	ОрганизацияОтбор);
	
	Если ЗначениеЗаполнено(ОрганизацияОтбор) Тогда
		ПравилоКонвертацииОрганизация = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Организации_Получение");
		тОрганизация = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, ОрганизацияОтбор, ПравилоКонвертацииОрганизация, "ПолучитьСсылку");
	КонецЕсли;
	тПериод = ПериодОтбор;
	
	ИсторияРегистраций = РегистрыСведений.УВМ_ИсторияРегистрацийВНалоговомОргане.СоздатьНаборЗаписей();
	ИсторияРегистраций.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов", Истина);
	ИсторияРегистраций.Отбор.Период.Установить(тПериод);
	ИсторияРегистраций.Отбор.Организация.Установить(тОрганизация);
	
	Для Каждого Запись Из Записи Цикл
		ЗаписьИсторияРегистраций = ИсторияРегистраций.Добавить();
		
		ЗаписьИсторияРегистраций.Период = тПериод;
		ЗаписьИсторияРегистраций.Организация = тОрганизация;  
		
		Если ЗначениеЗаполнено(Запись.РегистрацияВНалоговомОргане) Тогда
			ПравилоКонвертацииНалог = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_УВМ_РегистрацииВНалоговомОргане_Получение");
			ЗаписьИсторияРегистраций.РегистрацияВНалоговомОргане = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, Запись.РегистрацияВНалоговомОргане, ПравилоКонвертацииНалог, "ПолучитьСсылку");
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(тОрганизация.Ссылка) Тогда
		ИсторияРегистраций.ОбменДанными.Загрузка = Истина;  
		ИсторияРегистраций.Записать(Истина);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПКО_РегистрСведений_УВМ_ИсторияРегистрацийВНалоговомОргане_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.ДополнительныеСвойства.Вставить("ПериодОтбор",		ДанныеXDTO.ПериодОтбор);
	ПолученныеДанные.ДополнительныеСвойства.Вставить("ОрганизацияОтбор",ДанныеXDTO.СтруктурнаяЕдиницаОтбор);
	ПолученныеДанные.ДополнительныеСвойства.Вставить("Записи",          Неопределено);
	
	Если ДанныеXDTO.Свойство("Записи") И ЗначениеЗаполнено(ДанныеXDTO.Записи) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Записи", ДанныеXDTO.Записи);
	КонецЕсли;
КонецПроцедуры

Процедура ПКО_РегистрСведений_УВМ_ИсторияРегистрацийВНалоговомОргане_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)

	ОрганизацияСсылка = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
		КомпонентыОбмена,
		ПолученныеДанные.ДополнительныеСвойства.ОрганизацияОтбор,
		ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Организации_Получение"),
		"ПолучитьСсылку").Ссылка;
		
	ПолученныеДанные.Отбор.Организация.Значение = ОрганизацияСсылка;
	ПолученныеДанные.Отбор.Организация.Использование = Истина;
	
	Если ЗначениеЗаполнено(ПолученныеДанные.ДополнительныеСвойства.ПериодОтбор) Тогда
		ПолученныеДанные.Отбор.Период.Значение = ПолученныеДанные.ДополнительныеСвойства.ПериодОтбор;
		ПолученныеДанные.Отбор.Период.Использование = Истина;
	КонецЕсли;
	
	// Добавление записей в набор записей.
	Если ПолученныеДанные.ДополнительныеСвойства.Записи <> Неопределено Тогда
		Для Каждого Строка Из ПолученныеДанные.ДополнительныеСвойства.Записи Цикл
			СтрокаЗаписи = ПолученныеДанные.Добавить();
			СтрокаЗаписи.Организация = ОрганизацияСсылка;
			Если ЗначениеЗаполнено(ПолученныеДанные.ДополнительныеСвойства.ПериодОтбор) Тогда
				СтрокаЗаписи.Период = ПолученныеДанные.ДополнительныеСвойства.ПериодОтбор;
			Иначе
				СтрокаЗаписи.Период = ТекущаяДатаСеанса();
			КонецЕсли;
			СтрокаЗаписи.РегистрацияВНалоговомОргане = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
				КомпонентыОбмена,
				Строка.РегистрацияВНалоговомОргане,
				ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_УВМ_РегистрацииВНалоговомОргане_Получение"),
				"ПолучитьСсылку").Ссылка;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


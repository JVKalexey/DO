&После("ДобавитьПКО_Справочник_СтруктураПредприятия_Получение")
Процедура АБ_ДобавитьПКО_Справочник_СтруктураПредприятия_Получение(ПравилаКонвертации)
	
	ПравилоКонвертации = ПравилаКонвертации.Найти("Справочник_СтруктураПредприятия_Получение", "ИмяПКО");
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "Руководитель",   "Руководитель", 1, "Справочник_Сотрудники_Получение");
	
	//++dar 30.01.26 (307770)
	ПространствоРасширения = ПространствоРасширенияДО();
	ОбменДаннымиXDTOСервер.ИнициализироватьРасширениеПравилаКонвертацииОбъекта(ПравилоКонвертации, ПространствоРасширения);	
	ДобавитьПКС(СвойстваШапки, "УВМ_ПрефиксПодразделения",  "УВМ_ПрефиксПодразделения", , "Справочник_СтруктураПредприятия_Получение", ПространствоРасширения);
	//--dar 30.01.26 (307770)
	
КонецПроцедуры

&После("ПКО_Справочник_СтруктураПредприятия_Получение_ПриКонвертацииДанныхXDTO")
Процедура АБ_ПКО_Справочник_СтруктураПредприятия_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	
	Если ДанныеXDTO.Свойство("AdditionalInfo") И ТипЗнч(ДанныеXDTO.AdditionalInfo)=Тип("Структура") Тогда //ED
		
		ДопДанные = ДанныеXDTO.AdditionalInfo;
		
		Если ДопДанные.Свойство("Руководитель") Тогда
			
			Руководитель = ОбменДаннымиXDTOСервер.СсылкаОбъектаПоУИДОбъектаXDTO(
							ДопДанные.Руководитель,
							Тип("СправочникСсылка.Сотрудники"),
							КомпонентыОбмена);
			
			ПолученныеДанные.Руководитель = Руководитель;
			
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

&ИзменениеИКонтроль("ПКО_Справочник_СтруктураПредприятия_Получение_ПередЗаписьюПолученныхДанных")
Процедура АБ_ПКО_Справочник_СтруктураПредприятия_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	// Сделаем слияние полученной контактной информации и значений доп. реквизитов с уже имеющимися в ИБ данными.
	Если ДанныеИБ <> Неопределено Тогда
		ВыполнитьСлияниеТаблиц(ПолученныеДанные.ДополнительныеРеквизиты, ДанныеИБ.ДополнительныеРеквизиты, "Свойство");
	КонецЕсли;

	ДобавитьПризнакЭтоНовый(ПолученныеДанные, ДанныеИБ);

	ЗагрузитьДополнительныеСведения(
	?(ДанныеИБ = Неопределено,
	ПолученныеДанные.ПолучитьСсылкуНового(),
	ДанныеИБ.Ссылка),
	ПолученныеДанные.ДополнительныеСвойства,
	КомпонентыОбмена);

	Если ДанныеИБ = Неопределено Тогда
		УказанОсобыйРанг = ПолученныеДанные.УказанОсобыйРанг;
		Ранг = ПолученныеДанные.Ранг;
	Иначе
		РеквизитыПодразделенияПоСсылке = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ДанныеИБ.Ссылка,
		"Руководитель, Родитель, ПометкаУдаления, Наименование, Ранг, УказанОсобыйРанг");
		УказанОсобыйРанг = РеквизитыПодразделенияПоСсылке.УказанОсобыйРанг;
		Ранг = РеквизитыПодразделенияПоСсылке.Ранг;
		#Вставка
		//++dar 29.01.26 (308318)
		Если НЕ ЗначениеЗаполнено(ПолученныеДанные.Руководитель) И ЗначениеЗаполнено(РеквизитыПодразделенияПоСсылке.Руководитель) Тогда
			ПолученныеДанные.Руководитель = РеквизитыПодразделенияПоСсылке.Руководитель;
		КонецЕсли;
		//--dar 29.01.26 (308318)
		#КонецВставки
	КонецЕсли;
	#Вставка
	//++dar 30.01.26 (307770)
	УВМ_СсылкаНаПодразделение = ?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка);
	Если ЗначениеЗаполнено(ПолученныеДанные.УВМ_ПрефиксПодразделения) Тогда 
		РегистрыСведений.ИндексыНумерации.ЗаписатьИндексНумерации(УВМ_СсылкаНаПодразделение, ПолученныеДанные.УВМ_ПрефиксПодразделения);
	Иначе 
		РегистрыСведений.ИндексыНумерации.УдалитьИндексНумерации(УВМ_СсылкаНаПодразделение);
	КонецЕсли;
	//--dar 30.01.26 (307770)
	#КонецВставки
	
	Если Не ЗначениеЗаполнено(ПолученныеДанные.Ранг) Тогда
		Если УказанОсобыйРанг Тогда
			ПолученныеДанные.Ранг = Ранг;
		ИначеЕсли Не ЗначениеЗаполнено(ПолученныеДанные.Родитель) Тогда
			ПолученныеДанные.Ранг = 1;
		Иначе
			ПолученныеДанные.Ранг = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			ПолученныеДанные.Родитель, "Ранг") + 1;
		КонецЕсли;
	КонецЕсли;

	// Обновление адресной книги
	ОбновитьДанныеСтруктурыПредприятияВАдреснойКниге = Ложь;
	ОбновитьДанныеСотрудниковПодразделенияВАдреснойКниге = Истина;
	ОбновитьДанныеОтображенияСтруктурыПредприятияВАдреснойКниге = Ложь;
	ОбновитьСловаПоискаПоСтруктуреПредприятияВАдреснойКниге = Ложь;
	ОбновитьДоступностьВПоискеПоСтруктуреПредприятия = Ложь;
	ИзмененРанг = Ложь;

	Если ДанныеИБ = Неопределено Тогда

		ОбновитьДанныеСтруктурыПредприятияВАдреснойКниге = Истина;
		ОбновитьСловаПоискаПоСтруктуреПредприятияВАдреснойКниге = Истина;
		ИзмененРанг = Истина;

		ПолученныеДанные.ДополнительныеСвойства.Вставить(
		"ОбновитьДанныеСтруктурыПредприятияВАдреснойКниге",
		ОбновитьДанныеСтруктурыПредприятияВАдреснойКниге);
		ПолученныеДанные.ДополнительныеСвойства.Вставить(
		"ОбновитьДанныеСотрудниковПодразделенияВАдреснойКниге",
		ОбновитьДанныеСотрудниковПодразделенияВАдреснойКниге);
		ПолученныеДанные.ДополнительныеСвойства.Вставить(
		"ОбновитьДанныеОтображенияСтруктурыПредприятияВАдреснойКниге",
		ОбновитьДанныеОтображенияСтруктурыПредприятияВАдреснойКниге);
		ПолученныеДанные.ДополнительныеСвойства.Вставить(
		"ОбновитьСловаПоискаПоСтруктуреПредприятияВАдреснойКниге",
		ОбновитьСловаПоискаПоСтруктуреПредприятияВАдреснойКниге);
		ПолученныеДанные.ДополнительныеСвойства.Вставить(
		"ОбновитьДоступностьВПоискеПоСтруктуреПредприятия",
		ОбновитьДоступностьВПоискеПоСтруктуреПредприятия);
		ПолученныеДанные.ДополнительныеСвойства.Вставить(
		"ИзмененРанг",
		ИзмененРанг);

		ПолученныеДанные.ДополнительныеСвойства.Вставить(
		"СтарыйРуководитель",
		Неопределено);
		ПолученныеДанные.ДополнительныеСвойства.Вставить(
		"СтарыйРодитель",
		Неопределено);
		ПолученныеДанные.ДополнительныеСвойства.Вставить(
		"СтараяПометкаУдаления",
		Неопределено);
		ПолученныеДанные.ДополнительныеСвойства.Вставить(
		"СтарыйРанг",
		Неопределено);
		ПолученныеДанные.ДополнительныеСвойства.Вставить(
		"СтарыйУказанОсобыйРанг",
		Неопределено);

	Иначе

		Если РеквизитыПодразделенияПоСсылке.Родитель <> ПолученныеДанные.Родитель Тогда
			ОбновитьДанныеСтруктурыПредприятияВАдреснойКниге = Истина;
		КонецЕсли;
		Если РеквизитыПодразделенияПоСсылке.ПометкаУдаления <> ПолученныеДанные.ПометкаУдаления Тогда
			ОбновитьДанныеСтруктурыПредприятияВАдреснойКниге = Истина;
			ОбновитьДанныеСотрудниковПодразделенияВАдреснойКниге = Истина;
			ОбновитьДанныеОтображенияСтруктурыПредприятияВАдреснойКниге = Истина;
			ОбновитьДоступностьВПоискеПоСтруктуреПредприятия = Истина;
		КонецЕсли;
		Если РеквизитыПодразделенияПоСсылке.Наименование <> ПолученныеДанные.Наименование Тогда
			ОбновитьСловаПоискаПоСтруктуреПредприятияВАдреснойКниге = Истина;
			ОбновитьДанныеОтображенияСтруктурыПредприятияВАдреснойКниге = Истина;
			ОбновитьДанныеСтруктурыПредприятияВАдреснойКниге = Истина;
		КонецЕсли;

		Если РеквизитыПодразделенияПоСсылке.Ранг <> ПолученныеДанные.Ранг Тогда
			ИзмененРанг = Истина;
		КонецЕсли;

		ДанныеИБ.ДополнительныеСвойства.Вставить(
		"ОбновитьДанныеСтруктурыПредприятияВАдреснойКниге",
		ОбновитьДанныеСтруктурыПредприятияВАдреснойКниге);
		ДанныеИБ.ДополнительныеСвойства.Вставить(
		"ОбновитьДанныеСотрудниковПодразделенияВАдреснойКниге",
		ОбновитьДанныеСотрудниковПодразделенияВАдреснойКниге);
		ДанныеИБ.ДополнительныеСвойства.Вставить(
		"ОбновитьДанныеОтображенияСтруктурыПредприятияВАдреснойКниге",
		ОбновитьДанныеОтображенияСтруктурыПредприятияВАдреснойКниге);
		ДанныеИБ.ДополнительныеСвойства.Вставить(
		"ОбновитьСловаПоискаПоСтруктуреПредприятияВАдреснойКниге",
		ОбновитьСловаПоискаПоСтруктуреПредприятияВАдреснойКниге);
		ДанныеИБ.ДополнительныеСвойства.Вставить(
		"ОбновитьДоступностьВПоискеПоСтруктуреПредприятия",
		ОбновитьДоступностьВПоискеПоСтруктуреПредприятия);
		ДанныеИБ.ДополнительныеСвойства.Вставить(
		"ИзмененРанг",
		ИзмененРанг);

		ДанныеИБ.ДополнительныеСвойства.Вставить(
		"СтарыйРуководитель",
		РеквизитыПодразделенияПоСсылке.Руководитель);
		ДанныеИБ.ДополнительныеСвойства.Вставить(
		"СтарыйРодитель",
		РеквизитыПодразделенияПоСсылке.Родитель);
		ДанныеИБ.ДополнительныеСвойства.Вставить(
		"СтараяПометкаУдаления",
		РеквизитыПодразделенияПоСсылке.ПометкаУдаления);
		ДанныеИБ.ДополнительныеСвойства.Вставить(
		"СтарыйРанг",
		РеквизитыПодразделенияПоСсылке.Ранг);
		ДанныеИБ.ДополнительныеСвойства.Вставить(
		"СтарыйУказанОсобыйРанг",
		РеквизитыПодразделенияПоСсылке.УказанОсобыйРанг);

	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Справочник_ФизическиеЛица

&После("ДобавитьПКО_Справочник_ФизическиеЛица_Получение")
Процедура АБ_ДобавитьПКО_Справочник_ФизическиеЛица_Получение(ПравилаКонвертации)
	
	ПравилоКонвертации = ПравилаКонвертации.Найти("Справочник_ФизическиеЛица_Получение", "ИмяПКО");
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "",   "АБ_СоздатьПользователя", 1);  
	
КонецПроцедуры

&После("ПКО_Справочник_ФизическиеЛица_Получение_ПриКонвертацииДанныхXDTO")
Процедура АБ_ПКО_Справочник_ФизическиеЛица_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	
	Если ДанныеXDTO.Свойство("AdditionalInfo") И ТипЗнч(ДанныеXDTO.AdditionalInfo)=Тип("Структура") Тогда //ED
		
		ДопДанные = ДанныеXDTO.AdditionalInfo;
		
		Если ДопДанные.Свойство("АБ_СоздатьПользователя") Тогда
			
			ПолученныеДанные.ДополнительныеСвойства.Вставить("АБ_СоздатьПользователя");
			
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

&После("ПКО_Справочник_ФизическиеЛица_Получение_ПередЗаписьюПолученныхДанных")
Процедура АБ_ПКО_Справочник_ФизическиеЛица_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("АБ_СоздатьПользователя") Тогда
		
		СсылкаФизЛицо = ?(ДанныеИБ = Неопределено,   ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка);   
	    АБ_СоздатьПользователяФизЛицу(СсылкаФизЛицо, ПолученныеДанные.Наименование);
		
	КонецЕсли;


КонецПроцедуры

Процедура АБ_СоздатьПользователяФизЛицу(СсылкаФизЛицо, ФИО)  
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ первые 1
	|	Пользователи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.ФизЛицо = &ФизЛицо";
	
	Запрос.УстановитьПараметр("ФизЛицо", СсылкаФизЛицо);
	
	РезультатЗапроса = Запрос.Выполнить(); 
	Если Не РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;  
	
	НовПользователь = Справочники.Пользователи.СоздатьЭлемент();
	НовПользователь.ФизЛицо 			= СсылкаФизЛицо;
	НовПользователь.Наименование 		= ФИО;
	НовПользователь.ОбменДанными.Загрузка = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СпрСотрудники.Ссылка КАК СотрудникФизЛица
	               |ИЗ
	               |	Справочник.Сотрудники КАК СпрСотрудники ГДЕ СпрСотрудники.Владелец = &ФизЛицо И НЕ СпрСотрудники.ПометкаУдаления" ;
	
 	Запрос.УстановитьПараметр("ФизЛицо", СсылкаФизЛицо);
	
	ВыборкаСотрудники = Запрос.Выполнить().Выбрать(); 
	
	ПользовательИБ = ПользователиИнформационнойБазы.СоздатьПользователя();
    ПользовательИБ.Имя = ФИО;
    ПользовательИБ.ПолноеИмя = ФИО;
    ПользовательИБ.АутентификацияСтандартная = Истина;

	//++dar 27.10.25 (права на общий гриф)
	РГВсеСотрудники = АБ_ВызовСервера.ЗначениеКонстантыИзРегистра(Новый Структура("Ключ", "УВМ_РабочаяГруппаВсеСотрудники"));	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДескрипторыДоступаОбъектов.Ссылка КАК Дескриптор,
	|	ДескрипторыДоступаОбъектов.КонтейнерСотрудников КАК КонтейнерСотрудников,
	|	ДескрипторыДоступаОбъектов.Изменение КАК Изменение
	|ИЗ
	|	Справочник.ДескрипторыДоступаОбъектов КАК ДескрипторыДоступаОбъектов
	|ГДЕ
	|	ДескрипторыДоступаОбъектов.КонтейнерСотрудников = &ВсеСотрудники";
	Запрос.УстановитьПараметр("ВсеСотрудники", РГВсеСотрудники);
	ТаблДескрипторов = Запрос.Выполнить().Выгрузить();
	//--dar 27.10.25 (права на общий гриф)
	
	НачатьТранзакцию();
	Попытка
		
		ПользовательИБ.Записать();
		НовПользователь.ИдентификаторПользователяИБ = ПользовательИБ.УникальныйИдентификатор;

		НовПользователь.Записать();
				
		//Полномочие пользователь
		НовЗапись = РегистрыСведений.ПолномочияСотрудников.СоздатьМенеджерЗаписи();
		НовЗапись.Владелец 		= НовПользователь.Ссылка;
		НовЗапись.Полномочия 	= Справочники.ПрофилиГруппДоступа.НайтиПоНаименованию("Пользователи", Истина);
		НовЗапись.Записать();
		
		//флаг запросить пароль
		НовЗапись = РегистрыСведений.СведенияОПользователях.СоздатьМенеджерЗаписи();
		НовЗапись.Пользователь = НовПользователь.Ссылка; 
		//НовЗапись.ПотребоватьСменуПароляПриВходе = Истина;
		НовЗапись.Имя =  ФИО;
		НовЗапись.ВходВПрограммуРазрешен =  Истина;
		НовЗапись.ДатаРазрешенияВходаВПрограмму =  ТекущаяДатаСеанса();
		НовЗапись.Записать(); 	
		
		Пока ВыборкаСотрудники.Следующий() Цикл
		
			ТекЗапись = РегистрыСведений.СотрудникиПользователей.СоздатьМенеджерЗаписи();
			ТекЗапись.Пользователь = НовПользователь.Ссылка;
			ТекЗапись.Сотрудник    = ВыборкаСотрудники.СотрудникФизЛица;
			ТекЗапись.Записать();
			
			//++dar 03.10.25 (281921)
			ТекЗапись = РегистрыСведений.СотрудникиВКонтейнерах.СоздатьМенеджерЗаписи();
			ТекЗапись.Контейнер = ВыборкаСотрудники.СотрудникФизЛица;
			ТекЗапись.Сотрудник = ВыборкаСотрудники.СотрудникФизЛица;
			ТекЗапись.Записать();
			//--dar 03.10.25 (281921)
			
			//++dar 27.10.25 (права на общий гриф)
			Для Каждого СтрокаТЧ Из ТаблДескрипторов Цикл
				МенеджерЗаписи = РегистрыСведений.ПраваПоДескрипторамДоступаОбъектов.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Дескриптор = СтрокаТЧ.Дескриптор;
				МенеджерЗаписи.Сотрудник = ВыборкаСотрудники.СотрудникФизЛица;
				МенеджерЗаписи.Добавление = СтрокаТЧ.Изменение;
				МенеджерЗаписи.Изменение = СтрокаТЧ.Изменение;
				МенеджерЗаписи.Удаление = СтрокаТЧ.Изменение;
				МенеджерЗаписи.Чтение = Истина;               
				МенеджерЗаписи.Записать();
			КонецЦикла;
			
			ТекЗапись = РегистрыСведений.СотрудникиВКонтейнерах.СоздатьМенеджерЗаписи();
			ТекЗапись.Контейнер = РГВсеСотрудники;
			ТекЗапись.Сотрудник = ВыборкаСотрудники.СотрудникФизЛица;
			ТекЗапись.Записать();
			//--dar 27.10.25 (права на общий гриф)
			
		КонецЦикла;
			
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();  
	КонецПопытки;			
	
КонецПроцедуры   	


#Область РегистрыСведений_УВМ_ПричиныБлокировкиРазблокировкиКонтрагентов

Процедура ДобавитьПОД_Справочник_УВМ_ПричиныБлокировкиРазблокировкиКонтрагентов_Получение(ПравилаОбработкиДанных)
	ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
	ПравилоОбработки.Имя                     = "Справочник_УВМ_ПричиныБлокировкиРазблокировкиКонтрагентов_Получение";
	ПравилоОбработки.ОбъектВыборкиФормат     = "Справочник.УВМ_ПричиныБлокировкиРазблокировкиКонтрагентов";
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Справочник_УВМ_ПричиныБлокировкиРазблокировкиКонтрагентов_Получение");
КонецПроцедуры

Процедура ДобавитьПКО_Справочник_УВМ_ПричиныБлокировкиРазблокировкиКонтрагентов_Получение(ПравилаКонвертации)
	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО                       = "Справочник_УВМ_ПричиныБлокировкиРазблокировкиКонтрагентов_Получение";
	ПравилоКонвертации.ОбъектДанных                 = Метаданные.РегистрыСведений.УВМ_ПричиныБлокировкиРазблокировкиКонтрагентов;
	ПравилоКонвертации.ОбъектФормата                = "Справочник.УВМ_ПричиныБлокировкиРазблокировкиКонтрагентов";
	ПравилоКонвертации.ПриКонвертацииДанныхXDTO     = "ПКО_Справочник_УВМ_ПричиныБлокировкиРазблокировкиКонтрагентов_Получение_ПриКонвертацииДанныхXDTO";
	ПравилоКонвертации.ПередЗаписьюПолученныхДанных = "ПКО_Справочник_УВМ_ПричиныБлокировкиРазблокировкиКонтрагентов_Получение_ПередЗаписьюПолученныхДанных";
	ПравилоКонвертации.ВариантИдентификации         = "ПоПолямПоиска";
	
	ПространствоРасширения = ПространствоРасширенияДО();
	ОбменДаннымиXDTOСервер.ИнициализироватьРасширениеПравилаКонвертацииОбъекта(ПравилоКонвертации, ПространствоРасширения);
	
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "", "ПериодОтбор", 1, , ПространствоРасширения);
	ДобавитьПКС(СвойстваШапки, "", "КонтрагентОтбор", 1, "Справочник_Контрагенты_Получение", ПространствоРасширения);
	ПравилоКонвертации.ПоляПоиска.Добавить("Контрагент");
КонецПроцедуры

Процедура ПКО_Справочник_УВМ_ПричиныБлокировкиРазблокировкиКонтрагентов_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.ДополнительныеСвойства.Вставить("ПериодОтбор",
		ДанныеXDTO.ПериодОтбор);
	ПолученныеДанные.ДополнительныеСвойства.Вставить("КонтрагентОтбор",
		ДанныеXDTO.КонтрагентОтбор);
	ПолученныеДанные.ДополнительныеСвойства.Вставить("Записи",
		Неопределено);
	
	Если ДанныеXDTO.Свойство("Записи") И ЗначениеЗаполнено(ДанныеXDTO.Записи) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Записи", ДанныеXDTO.Записи);
	КонецЕсли;
КонецПроцедуры

Процедура ПКО_Справочник_УВМ_ПричиныБлокировкиРазблокировкиКонтрагентов_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ПКО_Контрагенты = ОбменДаннымиXDTOСервер.ПКОПоИмени(
		КомпонентыОбмена, "Справочник_Контрагенты_Получение");
	
	КонтрагентСсылка = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
		КомпонентыОбмена,
		ПолученныеДанные.ДополнительныеСвойства.КонтрагентОтбор,
		ПКО_Контрагенты,
		"ПолучитьСсылку").Ссылка;
		
	ПКО_Пользователи = ОбменДаннымиXDTOСервер.ПКОПоИмени(
		КомпонентыОбмена, "Справочник_Пользователи");
	
	ПКПД_СтатусыБлокировки = КомпонентыОбмена.ПравилаКонвертацииПредопределенныхДанных.Найти("Перечисление_УВМ_СтатусыБлокировкиКонтрагентов", "ИмяПКПД");
		
	ПолученныеДанные.Отбор.Контрагент.Значение = КонтрагентСсылка;
	ПолученныеДанные.Отбор.Контрагент.Использование = Истина;
	
	Если ЗначениеЗаполнено(ПолученныеДанные.ДополнительныеСвойства.ПериодОтбор) Тогда
		ПолученныеДанные.Отбор.Период.Значение = ПолученныеДанные.ДополнительныеСвойства.ПериодОтбор;
		ПолученныеДанные.Отбор.Период.Использование = Истина;
	КонецЕсли;
	
	// Добавление записей в набор записей.
	Если ПолученныеДанные.ДополнительныеСвойства.Записи <> Неопределено Тогда
		Для Каждого Строка Из ПолученныеДанные.ДополнительныеСвойства.Записи Цикл
			СтрокаЗаписи = ПолученныеДанные.Добавить();
			СтрокаЗаписи.Контрагент = КонтрагентСсылка;
			Если ЗначениеЗаполнено(ПолученныеДанные.ДополнительныеСвойства.ПериодОтбор) Тогда
				СтрокаЗаписи.Период = ПолученныеДанные.ДополнительныеСвойства.ПериодОтбор;
			Иначе
				СтрокаЗаписи.Период = ТекущаяДатаСеанса();
			КонецЕсли;
			СтрокаЗаписи.ПричинаБлокировкиРазблокировки = Строка.ПричинаБлокировкиРазблокировки;
			СтрокаЗаписи.Автор = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
				КомпонентыОбмена,
				Строка.Автор,
				ПКО_Пользователи,
				"ПолучитьСсылку").Ссылка;
			Если ТипЗнч(Строка.Статус) = Тип("Структура") Тогда
				ЗначениеСтатуса = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Строка.Статус, "Значение", Неопределено);
				Если ЗначениеСтатуса <> Неопределено Тогда
					СтрокаЗаписи.Статус = Перечисления.УВМ_СтатусыБлокировкиКонтрагентов[ЗначениеСтатуса];
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Справочник_Организации

&ИзменениеИКонтроль("ДобавитьПКО_Справочник_Организации_Получение")
Процедура АБ_ДобавитьПКО_Справочник_Организации_Получение(ПравилаКонвертации)
	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО                       = "Справочник_Организации_Получение";
	ПравилоКонвертации.ОбъектДанных                 = Метаданные.Справочники.Организации;
	ПравилоКонвертации.ОбъектФормата                = "Справочник.Организации";
	ПравилоКонвертации.ПриКонвертацииДанныхXDTO     = "ПКО_Справочник_Организации_Получение_ПриКонвертацииДанныхXDTO";
	ПравилоКонвертации.ПередЗаписьюПолученныхДанных = "ПКО_Справочник_Организации_Получение_ПередЗаписьюПолученныхДанных";
	ПравилоКонвертации.ПослеЗагрузкиВсехДанных      = "Организации_ПослеЗаписи";
	ПравилоКонвертации.ВариантИдентификации         = "СначалаПоУникальномуИдентификаторуПотомПоПолямПоиска";
	
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "ИНН",                    "ИНН");
	ДобавитьПКС(СвойстваШапки, "КодПоОКПО",              "ОКПО");
	ДобавитьПКС(СвойстваШапки, "Комментарий",            "Комментарий");
	ДобавитьПКС(СвойстваШапки, "КПП",                    "КПП");
	ДобавитьПКС(СвойстваШапки, "Наименование",           "Наименование");
	ДобавитьПКС(СвойстваШапки, "НаименованиеПолное",     "НаименованиеПолное");
	ДобавитьПКС(СвойстваШапки, "ОГРН",                   "ОГРН");
	ДобавитьПКС(СвойстваШапки, "ОсновнойБанковскийСчет", "ОсновнойБанковскийСчет", 1, "Справочник_БанковскиеСчета_Получение");
	ДобавитьПКС(СвойстваШапки, "Префикс",                "Префикс");
	ДобавитьПКС(СвойстваШапки, "ЮрФизЛицо",              "", 1);
#Вставка  
	// + СБит 2026-03-26 #УВМ 317078  
	ПространствоИмен = ПространствоИменУВМ();
	ДобавитьПКС(СвойстваШапки, "УВМ_КрупнейшийНалогоплательщик",     "УВМ_КрупнейшийНалогоплательщик",,,ПространствоИмен);
	ДобавитьПКС(СвойстваШапки, "УВМ_КодНалоговогоОрганаПолучателя",     "УВМ_КодНалоговогоОрганаПолучателя",,,ПространствоИмен);
	ДобавитьПКС(СвойстваШапки, "УВМ_КрупнейшийНалогоплательщикКПП",     "УВМ_КрупнейшийНалогоплательщикКПП",,,ПространствоИмен);
	ДобавитьПКС(СвойстваШапки, "УВМ_КрупнейшийНалогоплательщикНаименованиеНалоговогоОргана",     
		"УВМ_КрупнейшийНалогоплательщикНаименованиеНалоговогоОргана",,,ПространствоИмен);
	ДобавитьПКС(СвойстваШапки, "УВМ_КрупнейшийНалогоплательщикРегистрацияВНалоговомОргане", 
		"КрупнейшийНалогоплательщикРегистрацияВНалоговомОргане", 
		1, 
		"Справочник_УВМ_РегистрацииВНалоговомОргане_Получение", 
		ПространствоИмен);
#КонецВставки

	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "ДополнительныеРеквизиты", "");
	ДобавитьПКС(СвойстваТЧ, "Значение", "", 1);
	ДобавитьПКС(СвойстваТЧ, "Свойство", "", 1, "Справочник_ДополнительныеРеквизиты");

	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "КонтактнаяИнформация",    "");
	ДобавитьПКС(СвойстваТЧ, "Вид",           "", 1);
	ДобавитьПКС(СвойстваТЧ, "ЗначенияПолей", "", 1);
	ДобавитьПКС(СвойстваТЧ, "Представление", "", 1);
	ДобавитьПКС(СвойстваТЧ, "Тип",           "", 1);

	ПравилоКонвертации.ПоляПоиска.Добавить("ИНН,КПП");
	ПравилоКонвертации.ПоляПоиска.Добавить("НаименованиеПолное");
	ПравилоКонвертации.ПоляПоиска.Добавить("Наименование");
КонецПроцедуры

&ИзменениеИКонтроль("ПКО_Справочник_Организации_Получение_ПриКонвертацииДанныхXDTO")
Процедура АБ_ПКО_Справочник_Организации_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	// ЮрФизЛицо
	Если ДанныеXDTO.КлючевыеСвойства.ЮридическоеФизическоеЛицо.Значение = "ЮридическоеЛицо" Тогда
		ПолученныеДанные.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;
	Иначе
		ПолученныеДанные.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель;
	КонецЕсли;

	Если ЭтоЗагрузкаКлючевыхСвойств(ДанныеXDTO) Тогда
		Возврат;
	КонецЕсли;

#Вставка
	// + СБит 2026-04-02 #УВМ 317078
	ПолученныеДанные.УВМ_КрупнейшийНалогоплательщик	= ?(ДанныеXDTO.Свойство("УВМ_КрупнейшийНалогоплательщик"), ДанныеXDTO.УВМ_КрупнейшийНалогоплательщик, "");
	//++GIV 09042026 (317078)
	ПолученныеДанные.УВМ_КодНалоговогоОрганаПолучателя	= ?(ДанныеXDTO.Свойство("УВМ_КодНалоговогоОрганаПолучателя"), ДанныеXDTO.УВМ_КодНалоговогоОрганаПолучателя, "");
	ПолученныеДанные.УВМ_КрупнейшийНалогоплательщикКПП	= ?(ДанныеXDTO.Свойство("УВМ_КрупнейшийНалогоплательщикКПП"), ДанныеXDTO.УВМ_КрупнейшийНалогоплательщикКПП, "");
	ПолученныеДанные.УВМ_КрупнейшийНалогоплательщикНаименованиеНалоговогоОргана	= ?(ДанныеXDTO.Свойство("УВМ_КрупнейшийНалогоплательщикНаименованиеНалоговогоОргана"), 
	ДанныеXDTO.УВМ_КрупнейшийНалогоплательщикНаименованиеНалоговогоОргана, "");
	//--GIV 09042026 (317078)
	тКрупнейшийНалогоплательщикРегистрацияВНалоговомОргане = Справочники.УВМ_РегистрацииВНалоговомОргане.ПустаяСсылка();
	Если ДанныеXDTO.Свойство("КрупнейшийНалогоплательщикРегистрацияВНалоговомОргане") Тогда
		ПравилоКонвертацииРегистрация = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_УВМ_РегистрацииВНалоговомОргане_Получение");
		тКрупнейшийНалогоплательщикРегистрацияВНалоговомОргане = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, 
			ДанныеXDTO.КрупнейшийНалогоплательщикРегистрацияВНалоговомОргане, ПравилоКонвертацииРегистрация, "ПолучитьСсылку");
 	КонецЕсли;
	ПолученныеДанные.УВМ_КрупнейшийНалогоплательщикРегистрацияВНалоговомОргане	= тКрупнейшийНалогоплательщикРегистрацияВНалоговомОргане;
	// - СБит 2026-04-02 #УВМ
#КонецВставки
	ЗагрузитьДополнительныеРеквизиты(
	ПолученныеДанные,
	ДанныеXDTO,
	КомпонентыОбмена,
	Истина);
	ЗагрузитьКонтактнуюИнформацию(
	ДанныеXDTO,
	ПолученныеДанные,
	Справочники.ВидыКонтактнойИнформации.СправочникОрганизации);
КонецПроцедуры

&ИзменениеИКонтроль("ПКО_Справочник_Организации_Получение_ПередЗаписьюПолученныхДанных")
Процедура АБ_ПКО_Справочник_Организации_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	// Сделаем слияние полученной контактной информации и значений доп. реквизитов с уже имеющимися в ИБ данными.
	Если ДанныеИБ <> Неопределено Тогда
		ВыполнитьСлияниеТаблиц(ПолученныеДанные.КонтактнаяИнформация, ДанныеИБ.КонтактнаяИнформация, "Тип,Вид");
		ВыполнитьСлияниеТаблиц(ПолученныеДанные.ДополнительныеРеквизиты, ДанныеИБ.ДополнительныеРеквизиты, "Свойство");
	КонецЕсли;

	ЗагрузитьДополнительныеСведения(
	?(ДанныеИБ = Неопределено,
	ПолученныеДанные.ПолучитьСсылкуНового(),
	ДанныеИБ.Ссылка),
	ПолученныеДанные.ДополнительныеСвойства,
	КомпонентыОбмена);

	ДобавитьСвязьОбъектаДОИВнешнегоОбъекта(
	ДанныеИБ,
	ПолученныеДанные,
	"Справочник.Организации");

	#Вставка
	//++dar 30.01.26 (307770) 
	УВМ_СсылкаНаОрганизацию = ?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка);
	Если ЗначениеЗаполнено(ПолученныеДанные.Префикс) Тогда 
		РегистрыСведений.ИндексыНумерации.ЗаписатьИндексНумерации(УВМ_СсылкаНаОрганизацию, ПолученныеДанные.Префикс);
	Иначе 
		РегистрыСведений.ИндексыНумерации.УдалитьИндексНумерации(УВМ_СсылкаНаОрганизацию);
	КонецЕсли;
	//--dar 30.01.26 (307770)
	#КонецВставки
	ДобавитьПризнакЭтоНовый(ПолученныеДанные, ДанныеИБ);

	// Обновление адресной книги
	ОбновитьДанныеОрганизацииВАдреснойКниге = Ложь;
	ОбновитьСловаПоискаПоОрганизацииВАдреснойКниге = Ложь;
	ОбновитьДанныеОтображенияОрганизацииВАдреснойКниге = Ложь;
	ОбновитьДоступностьВПоискеПоОрганизации = Ложь;

	Если ДанныеИБ = Неопределено Тогда

		ОбновитьДанныеОрганизацииВАдреснойКниге = Истина;
		ОбновитьСловаПоискаПоОрганизацииВАдреснойКниге = Истина;

		ПолученныеДанные.ДополнительныеСвойства.Вставить(
		"ОбновитьДанныеОрганизацииВАдреснойКниге",
		ОбновитьДанныеОрганизацииВАдреснойКниге);
		ПолученныеДанные.ДополнительныеСвойства.Вставить(
		"ОбновитьСловаПоискаПоОрганизацииВАдреснойКниге",
		ОбновитьСловаПоискаПоОрганизацииВАдреснойКниге);
		ПолученныеДанные.ДополнительныеСвойства.Вставить(
		"ОбновитьДанныеОтображенияОрганизацииВАдреснойКниге",
		ОбновитьДанныеОтображенияОрганизацииВАдреснойКниге);
		ПолученныеДанные.ДополнительныеСвойства.Вставить(
		"ОбновитьДоступностьВПоискеПоОрганизации",
		ОбновитьДоступностьВПоискеПоОрганизации);

	Иначе

		РеквизитыРолиПоСсылке = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ДанныеИБ.Ссылка, "Наименование, ПометкаУдаления");

		Если РеквизитыРолиПоСсылке.ПометкаУдаления <> ПолученныеДанные.ПометкаУдаления Тогда
			ОбновитьДанныеОрганизацииВАдреснойКниге = Истина;
			ОбновитьДанныеОтображенияОрганизацииВАдреснойКниге = Истина;
			ОбновитьДоступностьВПоискеПоОрганизации = Истина;
		КонецЕсли;

		Если РеквизитыРолиПоСсылке.Наименование <> ПолученныеДанные.Наименование Тогда
			ОбновитьДанныеОрганизацииВАдреснойКниге = Истина;
			ОбновитьДанныеОтображенияОрганизацииВАдреснойКниге = Истина;
			ОбновитьСловаПоискаПоОрганизацииВАдреснойКниге = Истина;
		КонецЕсли;

		ДанныеИБ.ДополнительныеСвойства.Вставить(
		"ОбновитьДанныеОрганизацииВАдреснойКниге",
		ОбновитьДанныеОрганизацииВАдреснойКниге);
		ДанныеИБ.ДополнительныеСвойства.Вставить(
		"ОбновитьСловаПоискаПоОрганизацииВАдреснойКниге",
		ОбновитьСловаПоискаПоОрганизацииВАдреснойКниге);
		ДанныеИБ.ДополнительныеСвойства.Вставить(
		"ОбновитьДанныеОтображенияОрганизацииВАдреснойКниге",
		ОбновитьДанныеОтображенияОрганизацииВАдреснойКниге);
		ДанныеИБ.ДополнительныеСвойства.Вставить(
		"ОбновитьДоступностьВПоискеПоОрганизации",
		ОбновитьДоступностьВПоискеПоОрганизации);

	КонецЕсли;

	// Определим основной банковский счет.
	ОбновитьОсновнойБанковскийСчет(ПолученныеДанные, ДанныеИБ);
КонецПроцедуры

#КонецОбласти


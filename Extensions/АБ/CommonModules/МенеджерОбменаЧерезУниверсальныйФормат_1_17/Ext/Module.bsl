Процедура ПКО_Справочник_Файлы_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	
	ОтменитьВыгрузкуФайла = Ложь;
	
	ВыгружаемыеДанныеДоп = Новый Структура;
	ВыгружаемыеДанныеДоп.Вставить("БазаИсточник", "Документооборот");
	
	Если ЗначениеЗаполнено(ДанныеИБ.ТекущаяВерсияТом) Тогда
		ПутьКТому = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеИБ.ТекущаяВерсияТом, "ПолныйПутьWindows");
		ДанныеXDTO.Вставить("ПутьКТому", ПутьКТому);
	Иначе
		ОтменитьВыгрузкуФайла = Истина;
	КонецЕсли;

	Если ЗначениеЗаполнено(ДанныеИБ.ВладелецФайла) Тогда
		ИДДоговораЕРП = "";
		ТипВнешнегоОбъекта = "";
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("СсылкаНаОбъектДО", ДанныеИБ.ВладелецФайла);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СвязиОбъектовИнтегрированныхСистем.УзелИнтегрированнойСистемы КАК УзелИнтегрированнойСистемы,
		|	СвязиОбъектовИнтегрированныхСистем.СсылкаНаОбъектДО КАК СсылкаНаОбъектДО,
		|	СвязиОбъектовИнтегрированныхСистем.ТипВнешнегоОбъекта КАК ТипВнешнегоОбъекта,
		|	СвязиОбъектовИнтегрированныхСистем.ИДВнешнегоОбъекта КАК ИДВнешнегоОбъекта
		|ИЗ
		|	РегистрСведений.СвязиОбъектовИнтегрированныхСистем КАК СвязиОбъектовИнтегрированныхСистем
		|ГДЕ
		|	СвязиОбъектовИнтегрированныхСистем.СсылкаНаОбъектДО = &СсылкаНаОбъектДО
		|	И (СвязиОбъектовИнтегрированныхСистем.ТипВнешнегоОбъекта = ""Справочник.ДоговорыКонтрагентов""
		|			ИЛИ СвязиОбъектовИнтегрированныхСистем.ТипВнешнегоОбъекта = ""Справочник.ДоговорыАренды"")";		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ИДДоговораЕРП = Выборка.ИДВнешнегоОбъекта;
			ТипВнешнегоОбъекта = Выборка.ТипВнешнегоОбъекта;
		КонецЕсли;
		
		ДанныеXDTO.Вставить("УВМ_УИДВладельца", ИДДоговораЕРП); 	
		ВыгружаемыеДанныеДоп.Вставить("ТипВнешнегоОбъекта", ТипВнешнегоОбъекта);
		
		Если НЕ ЗначениеЗаполнено(ИДДоговораЕРП) Тогда
			ОтменитьВыгрузкуФайла = Истина;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТипВнешнегоОбъекта) Тогда
			ОтменитьВыгрузкуФайла = Истина;
		КонецЕсли;
		
	Иначе
		ОтменитьВыгрузкуФайла = Истина;
	КонецЕсли;

	
	ДанныеОФайлах = Делопроизводство.ПолучитьДанныеФайловДляСписка(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДанныеИБ.Ссылка));
	Если ДанныеОФайлах.Количество() > 0 Тогда
		ДанныеОФайле = ДанныеОФайлах[0];
		
		ВидДокументаЕРП = ВидДокументаВЕРП(ДанныеОФайле.РольФайла);
		Если НЕ ЗначениеЗаполнено(ВидДокументаЕРП) Тогда
			ОтменитьВыгрузкуФайла = Истина;
		КонецЕсли;
		
		ВыгружаемыеДанныеДоп.Вставить("ВидДокумента", ВидДокументаЕРП);
		ВыгружаемыеДанныеДоп.Вставить("ЯвляетсяОригиналом", ДанныеОФайле.Оригинал);
		ВыгружаемыеДанныеДоп.Вставить("ЯвляетсяКопией", ДанныеОФайле.УВМ_ЯвляетсяКопией);
		ВыгружаемыеДанныеДоп.Вставить("ПометкаУдаления", ДанныеОФайле.ПометкаУдаления);
	Иначе
		ОтменитьВыгрузкуФайла = Истина;
	КонецЕсли;
	
	AdditionalInfoВставитьДопДанные(ДанныеXDTO, ВыгружаемыеДанныеДоп);
	
	Если ОтменитьВыгрузкуФайла Тогда
		ДанныеXDTO = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

Функция ВидДокументаВЕРП(РольФайла)
	
	Результат = "";
	
	ВидДоговорПоставки = АБ_ВызовСервера.ЗначениеКонстантыИзРегистра(Новый Структура("Ключ, КлючДополнительный", "УВМ_РольФайлаДляОбмена", "ДоговорПоставки"));
	ВидСоглашениеОбЭДО = АБ_ВызовСервера.ЗначениеКонстантыИзРегистра(Новый Структура("Ключ, КлючДополнительный", "УВМ_РольФайлаДляОбмена", "СоглашениеОбЭДО"));
	ВидОригиналДоговора = АБ_ВызовСервера.ЗначениеКонстантыИзРегистра(Новый Структура("Ключ, КлючДополнительный", "УВМ_РольФайлаДляОбмена", "ОригиналДоговора"));
	
	Если РольФайла = ВидДоговорПоставки Тогда
		Результат = "Договор поставки";
	ИначеЕсли РольФайла = ВидСоглашениеОбЭДО Тогда
		Результат = "Соглашение об ЭДО";
	ИначеЕсли РольФайла = ВидОригиналДоговора Тогда
		Результат = "Оригинал договора, соглашение об ЭДО";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


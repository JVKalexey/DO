Процедура ДобавитьПОД_Справочник_Сотрудники_Получение(ПравилаОбработкиДанных)
	
	ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
	ПравилоОбработки.Имя                     = "Справочник_Сотрудники_Получение";
	ПравилоОбработки.ОбъектВыборкиФормат     = "Справочник.Сотрудники";
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Справочник_Сотрудники_Получение");
	
КонецПроцедуры

Процедура ДобавитьПКО_Справочник_Сотрудники_Получение(ПравилаКонвертации)	

	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	
	ПравилоКонвертации.ВариантИдентификации         = "СначалаПоУникальномуИдентификаторуПотомПоПолямПоиска";

	ПравилоКонвертации.ИмяПКО            = "Справочник_Сотрудники_Получение";
	ПравилоКонвертации.ОбъектФормата     = "Справочник.Сотрудники";
	ПравилоКонвертации.ОбъектДанных      = Метаданные.Справочники.Сотрудники;
	ПравилоКонвертации.ПространствоИмен  = "http://v8.1c.ru/edi/AB_edi_stnd/EnterpriseData/1.17";
	
	ПравилоКонвертации.ПриКонвертацииДанныхXDTO     = "ПКО_Справочник_Сотрудники_ПриКонвертацииДанныхXDTO";

	ОбменДаннымиXDTOСервер.ИнициализироватьРасширениеПравилаКонвертацииОбъекта(ПравилоКонвертации, "http://v8.1c.ru/edi/AB_edi_stnd/EnterpriseData/1.17");
	
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "Наименование",   "Наименование");
	ДобавитьПКС(СвойстваШапки, "Должность", 	 "Должность", 	   , "Справочник_Должности_Получение", "http://v8.1c.ru/edi/AB_edi_stnd/EnterpriseData/1.17");
	ДобавитьПКС(СвойстваШапки, "Владелец", 		 "Владелец",  	   , "Справочник_ФизическиеЛица_Получение", "http://v8.1c.ru/edi/AB_edi_stnd/EnterpriseData/1.17");
	ДобавитьПКС(СвойстваШапки, "Подразделение",  "Подразделение", 1, "Справочник_СтруктураПредприятия_Получение");
	
	ПравилоКонвертации.ПоляПоиска.Добавить("Наименование,Владелец");

КонецПроцедуры

Процедура АБ_ПКО_Справочник_Сотрудники_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	
	Подразделение = ОбменДаннымиXDTOСервер.СсылкаОбъектаПоУИДОбъектаXDTO(
							ДанныеXDTO.Подразделение,
							Тип("СправочникСсылка.СтруктураПредприятия"),
							КомпонентыОбмена);
			
	ПолученныеДанные.Подразделение = Подразделение;

КонецПроцедуры

#КонецОбласти


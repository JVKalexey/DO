Процедура ДобавитьПКО_Справочник_УВМ_ОтветственныеЛицаОрганизаций_Получение(ПравилаКонвертации)
	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО                       = "Справочник_УВМ_ОтветственныеЛицаОрганизаций_Получение";
	ПравилоКонвертации.ОбъектДанных                 = Метаданные.Справочники.АБ_ОтветственныеЛицаОрганизаций;
	ПравилоКонвертации.ОбъектФормата                = "Справочник.УВМ_ОтветственныеЛицаОрганизаций"; //@NON-NLS-1
	ПравилоКонвертации.ПриКонвертацииДанныхXDTO     = "ПКО_Справочник_УВМ_ОтветственныеЛицаОрганизаций_Получение_ПриКонвертацииДанныхXDTO";
	ПравилоКонвертации.ПередЗаписьюПолученныхДанных = "ПКО_Справочник_УВМ_ОтветственныеЛицаОрганизаций_Получение_ПередЗаписьюПолученныхДанных";
	ПравилоКонвертации.ВариантИдентификации         = "ПоУникальномуИдентификатору";
	
	ПространствоРасширения = ПространствоРасширенияДО();
	ОбменДаннымиXDTOСервер.ИнициализироватьРасширениеПравилаКонвертацииОбъекта(ПравилоКонвертации, ПространствоРасширения);	
	
	
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "Владелец"                  ,"Организация",0,"Справочник_Организации_Получение",ПространствоРасширения);
	ДобавитьПКС(СвойстваШапки, "Наименование"              ,"Наименование",0,                                 ,ПространствоРасширения);
	ДобавитьПКС(СвойстваШапки, "ОтветственноеЛицо"         , "ОтветственноеЛицоПредставление", 0,             ,ПространствоРасширения);
	ДобавитьПКС(СвойстваШапки, "ФизическоеЛицо"            ,"", 1,                                            ,ПространствоРасширения);
	ДобавитьПКС(СвойстваШапки, "Должность"                 ,"ДолжностьДляПечати", 0,                          ,ПространствоРасширения);
	ДобавитьПКС(СвойстваШапки, "ДатаНачала"                ,"ДатаНачала", 0,                                  ,ПространствоРасширения);
	ДобавитьПКС(СвойстваШапки, "ДатаОкончания"             ,"ДатаОкончания", 0,                               ,ПространствоРасширения);
	ДобавитьПКС(СвойстваШапки, "ПравоПодписиПоДоверенности","ПравоПодписиПоДоверенности", 0,                  ,ПространствоРасширения);
	ДобавитьПКС(СвойстваШапки, "ДокументПраваПодписи"      ,"ДокументПраваПодписи"      , 0,                  ,ПространствоРасширения);
	ДобавитьПКС(СвойстваШапки, "НомерДокументаПраваПодписи","НомерДокументаПраваПодписи", 0,                  ,ПространствоРасширения);
	ДобавитьПКС(СвойстваШапки, "ДатаДокументаПраваПодписи" ,"ДатаДокументаПраваПодписи" , 0,                  ,ПространствоРасширения);
	ДобавитьПКС(СвойстваШапки, "ОснованиеПраваПодписи"     ,"ОснованиеПраваПодписи"     , 0,                  ,ПространствоРасширения);
	ДобавитьПКС(СвойстваШапки, "ДолжностьСсылка"           ,"", 1,                                            ,ПространствоРасширения);
	ДобавитьПКС(СвойстваШапки, "ЕстьПравоПодписиИсходящихДоговоров","ЕстьПравоПодписиИсходящихДоговоров", 0,  ,ПространствоРасширения);

КонецПроцедуры

Процедура ДобавитьПОД_Справочник_УВМ_ОтветственныеЛицаОрганизаций_Получение(ПравилаОбработкиДанных)
	ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
	ПравилоОбработки.Имя                     = "Справочник_УВМ_ОтветственныеЛицаОрганизаций_Получение";
	ПравилоОбработки.ОбъектВыборкиФормат     = "Справочник.УВМ_ОтветственныеЛицаОрганизаций"; //@NON-NLS-1
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Справочник_УВМ_ОтветственныеЛицаОрганизаций_Получение");
КонецПроцедуры

Процедура ПКО_Справочник_УВМ_ОтветственныеЛицаОрганизаций_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	
	Если ТипЗнч(ДанныеXDTO) = Тип("Структура") И ДанныеXDTO.Свойство("ФизическоеЛицо") 
		и ТипЗнч(ДанныеXDTO.ФизическоеЛицо)=Тип("Структура") тогда
		
		ПараметрФИО = "";
		ДанныеXDTO.ФизическоеЛицо.Свойство("ФИО",ПараметрФИО);
		ПараметрИНН = "";
		ДанныеXDTO.ФизическоеЛицо.Свойство("ИНН",ПараметрИНН);
		ПараметрДатаРождения = '00010101';
		ДанныеXDTO.ФизическоеЛицо.Свойство("ДатаРождения",ПараметрДатаРождения);
		
		ЗапросФЛ = Новый Запрос;
		ЗапросФЛ.УстановитьПараметр("ФИО",ПараметрФИО);
		ЗапросФЛ.УстановитьПараметр("ИНН",ПараметрИНН);
		ЗапросФЛ.УстановитьПараметр("ДатаРождения",ПараметрДатаРождения);
		ЗапросФЛ.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФизическиеЛица.Ссылка КАК ФЛСсылка,
		|	ВЫБОР
		|		КОГДА ФизическиеЛица.ИНН = &ИНН
		|				И &ИНН <> """"
		|				И (ФизическиеЛица.ДатаРождения = &ДатаРождения
		|					И &ДатаРождения <> ДАТАВРЕМЯ(1, 1, 1))
		|			ТОГДА 1
		|		КОГДА ФизическиеЛица.ИНН = &ИНН
		|				И &ИНН <> """"
		|			ТОГДА 2
		|		КОГДА ФизическиеЛица.ДатаРождения = &ДатаРождения
		|				И &ДатаРождения <> ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА 3
		|		ИНАЧЕ 4
		|	КОНЕЦ КАК Приоритет
		|ИЗ
		|	Справочник.ФизическиеЛица КАК ФизическиеЛица
		|ГДЕ
		|	ФизическиеЛица.Наименование = &ФИО
		|	И &ФИО <> """"
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет";
		
		ВыборкаФЛ = ЗапросФЛ.Выполнить().Выбрать();
		Если ВыборкаФЛ.Следующий() тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ФизическоеЛицо",ВыборкаФЛ.ФЛСсылка);
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеXDTO) = Тип("Структура") И ДанныеXDTO.Свойство("Должность") и ТипЗнч(ДанныеXDTO.Должность)=Тип("Структура") тогда
		
		ПараметрНаименование = "";
		ДанныеXDTO.Должность.Свойство("Наименование",ПараметрНаименование);
		ПараметрНаименованиеДляПечати = "";
		ДанныеXDTO.Свойство("ДолжностьДляПечати",ПараметрНаименованиеДляПечати);

		ЗапросДолжности = Новый Запрос();
		ЗапросДолжности.УстановитьПараметр("Наименование",ПараметрНаименование);
		ЗапросДолжности.УстановитьПараметр("НаименованиеДляПечати",ПараметрНаименованиеДляПечати);
		ЗапросДолжности.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Должности.Ссылка КАК ДолжностьСсылка
		|ИЗ
		|	Справочник.Должности КАК Должности
		|ГДЕ
		|	Должности.Наименование = &Наименование
		|	И &Наименование <> """"
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Должности.Ссылка
		|ИЗ
		|	Справочник.Должности КАК Должности
		|ГДЕ
		|	Должности.Наименование = &НаименованиеДляПечати
		|	И &НаименованиеДляПечати <> """" ";
		ВыборкаДолжности = ЗапросДолжности.Выполнить().Выбрать();
		Если ВыборкаДолжности.Следующий() тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ДолжностьСсылка",ВыборкаДолжности.ДолжностьСсылка);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПКО_Справочник_УВМ_ОтветственныеЛицаОрганизаций_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если не ЗначениеЗаполнено(ПолученныеДанные.ФизическоеЛицо) тогда
		ПолученныеДанные = Неопределено;
	КонецЕсли;
КонецПроцедуры

Процедура ПКО_Справочник_УВМ_РегистрацииВНалоговомОргане_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Организация = Неопределено;
	Если ДанныеXDTO.Свойство("КлючевыеСвойства") Тогда
		ДанныеXDTO.КлючевыеСвойства.Свойство("Организация", Организация);
	Иначе
		ДанныеXDTO.Свойство("Организация", Организация);
	КонецЕсли;
	ПолученныеДанные.ДополнительныеСвойства.Вставить("Владелец", Новый Структура("Значение, ИмяПКО", Организация, "Справочник_Организации_Получение"));
	//++GIV 09042026 (317078)
	Если ДанныеXDTO.Свойство("ДатаПостановкиНаУчет") Тогда
		ПолученныеДанные.ДатаПостановкиНаУчет = ПрочитатьДатуJSON(ДанныеXDTO.ДатаПостановкиНаУчет, ФорматДатыJSON.ISO);
	КонецЕсли;
	Если ДанныеXDTO.Свойство("ДатаСнятияСУчета") Тогда
		ПолученныеДанные.ДатаСнятияСУчета = ПрочитатьДатуJSON(ДанныеXDTO.ДатаСнятияСУчета, ФорматДатыJSON.ISO);
	КонецЕсли;  
	
	ПолученныеДанные.ДополнительныеСвойства.Вставить("ЗаписатьИсториюКПП", AdditionalInfoПолучить(ДанныеXDTO, "ЗаписатьИсториюКПП", Ложь));
	//--GIV 09042026 (317078)
	//++GIV 14042026 (бн)
	Если ДанныеXDTO.Свойство("КонтактнаяИнформация") Тогда
		Для каждого СтрокаДанныхXDTOКонтактная Из ДанныеXDTO.КонтактнаяИнформация Цикл
			Если СтрокаДанныхXDTOКонтактная.ВидКонтактнойИнформации = "ПользовательскаяКИАдрес" Тогда 
				ТекВидКИ = Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации;
			ИначеЕсли СтрокаДанныхXDTOКонтактная.ВидКонтактнойИнформации = "ЮридическийАдрес" Тогда
				ТекВидКИ = Справочники.ВидыКонтактнойИнформации.НайтиПоРеквизиту("ИдентификаторДляФормул", "АдресНалоговогоОргана");
			ИначеЕсли СтрокаДанныхXDTOКонтактная.ВидКонтактнойИнформации = "Телефон" Тогда
				ТекВидКИ = Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации;
			Иначе
				ТекВидКИ = Справочники.ВидыКонтактнойИнформации.ДругаяИнформацияОрганизации;
			КонецЕсли;
			УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(
			ПолученныеДанные,
			СокрЛП(СтрокаДанныхXDTOКонтактная.ЗначенияПолей),
			ТекВидКИ);
		КонецЦикла;
	КонецЕсли;
	//ЗагрузитьКонтактнуюИнформацию(
	//ДанныеXDTO,
	//ПолученныеДанные,
	//Справочники.ВидыКонтактнойИнформации.СправочникОрганизации);
	//--GIV 14042026 (бн)
КонецПроцедуры

Процедура ПКО_Справочник_УВМ_РегистрацииВНалоговомОргане_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	//++GIV 09042026 (317078)
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("ЗаписатьИсториюКПП")  Тогда
		Если ЗначениеЗаполнено(ПолученныеДанные.ДополнительныеСвойства.ЗаписатьИсториюКПП) Тогда 
			мЗаписи = РегистрыСведений.ИсторияКППЮрлиц.СоздатьМенеджерЗаписи();
			мЗаписи.КПП = ПолученныеДанные.КПП;
			мЗаписи.Юрлицо = ПолученныеДанные.Владелец;
			мЗаписи.Период = ПолученныеДанные.ДатаПостановкиНаУчет;
			Попытка
				мЗаписи.Записать(Истина);
			Исключение
				ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Обмен данными", УровеньЖурналаРегистрации.Ошибка, 
				Метаданные.Справочники.УВМ_РегистрацииВНалоговомОргане, 
				"Ошибка записи истории КПП", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	//--GIV 09042026 (317078)
	//++GIV 14042026 (бн)
	Если ДанныеИБ <> Неопределено Тогда
		ВыполнитьСлияниеТаблиц(ПолученныеДанные.КонтактнаяИнформация, ДанныеИБ.КонтактнаяИнформация, "Тип,Вид");
	КонецЕсли;
	//--GIV 14042026 (бн)
КонецПроцедуры


//++GIV 09042026 (317078)
Функция AdditionalInfoПолучить(ДанныеXDTO, ИмяРеквизита, ЗначениеПоУмолчанию = Неопределено)
	Если ДанныеXDTO.Свойство("AdditionalInfo")
            И ТипЗнч(ДанныеXDTO.AdditionalInfo)=Тип("Структура") Тогда
        
        ДопДанные = ДанныеXDTO.AdditionalInfo;
        
        Если ДопДанные.Свойство(ИмяРеквизита) Тогда
			Возврат ДопДанные[ИмяРеквизита];
		Иначе
			Возврат ЗначениеПоУмолчанию;			
        КонецЕсли;
    КонецЕсли;
КонецФункции

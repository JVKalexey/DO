Процедура ПКО_Справочник_КонтактныеЛицаКонтрагентов_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	
	Если ДанныеXDTO.Свойство("ОписаниеДолжности") Тогда
		Если ЗначениеЗаполнено(ДанныеXDTO.ОписаниеДолжности) Тогда
			НайденнаяДолжность = Справочники.ДолжностиКонтактныхЛиц.НайтиПоНаименованию(ДанныеXDTO.ОписаниеДолжности, Истина);
			Если НЕ ЗначениеЗаполнено(НайденнаяДолжность) Тогда
				НоваяДКЛ = Справочники.ДолжностиКонтактныхЛиц.СоздатьЭлемент();
				НоваяДКЛ.Наименование = ДанныеXDTO.ОписаниеДолжности;
				НоваяДКЛ.Записать(); 
				НайденнаяДолжность = НоваяДКЛ.Ссылка;
			КонецЕсли;	
			ПолученныеДанные.Должность = НайденнаяДолжность;
		КонецЕсли;
	КонецЕсли;

	ЗагрузитьКонтактнуюИнформацию(
		ДанныеXDTO,
		ПолученныеДанные,
		Справочники.ВидыКонтактнойИнформации.СправочникКонтактныеЛица);
		
